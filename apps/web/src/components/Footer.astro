---
import client from '../../../../client.json';

interface Props {
  siteName?: string;
  legalName?: string;
  footerLogoUrl?: string | null;
  socialLinks?: any[];
  siteSettings?: any;
}

const { 
  siteName = client.business.name, 
  legalName = client.business.legalName || siteName, 
  footerLogoUrl, 
  socialLinks = [], 
  siteSettings 
} = Astro.props;

// Resolve contact details dynamically from Sanity CMS siteSettings with fallback to client.json
const resolvedAddress = siteSettings?.primaryAddress || (client.contact.address ? `${client.contact.address.street}, ${client.contact.address.city}, ${client.contact.address.state} ${client.contact.address.zip}, ${client.contact.address.country}` : client.contact.location);
const resolvedEmail = siteSettings?.primaryEmail || client.contact.primaryEmail;
const resolvedPhone = siteSettings?.primaryPhone || client.contact.primaryPhone;
const resolvedGst = siteSettings?.gstNumber || (client.business as any).gstNumber;
const resolvedTagline = siteSettings?.seoDescription || client.business.tagline;
const resolvedDescription = siteSettings?.seoDescription || client.business.description;

// Format multi-line address
const formattedAddress = typeof resolvedAddress === 'string'
  ? resolvedAddress
  : `${resolvedAddress?.street || ''}, ${resolvedAddress?.city || ''}, ${resolvedAddress?.state || ''} ${resolvedAddress?.postalCode || ''}, ${resolvedAddress?.country || ''}`;

// Social SVG Helper
function getPlatformSvg(platform: string) {
  const p = (platform || '').toLowerCase();
  if (p.includes('linkedin')) {
    return `<svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`;
  }
  if (p.includes('instagram')) {
    return `<svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`;
  }
  if (p.includes('twitter') || p.includes('x')) {
    return `<svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`;
  }
  if (p.includes('facebook')) {
    return `<svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`;
  }
  if (p.includes('youtube')) {
    return `<svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`;
  }
  if (p.includes('whatsapp')) {
    return `<svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>`;
  }
  return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`;
}
---

<!-- Footer Root Container -->
<footer class="relative overflow-hidden bg-background">

  <!-- 1. Pre-Footer Action Card (28px radius, 24px padding) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-14 sm:pb-20">
    <div class="card-arcade relative overflow-hidden group bg-white border border-[#F2D8E6] rounded-[28px] p-6 sm:p-8 lg:p-10 shadow-[0_8px_30px_rgba(90,33,73,0.06)]">
      <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#FF3DA5] via-[#853676] to-[#5A2149]"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Left Content -->
        <div class="lg:col-span-8 space-y-3 text-left">
          <span class="font-label uppercase font-bold text-[#853676] block text-xs tracking-wider">
            {resolvedTagline}
          </span>
          <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-heading font-bold tracking-tight text-[#5A2149] leading-tight">
            Ready to begin your journey?<br class="hidden sm:block" />
            We are here with care and compassion.
          </h2>
          <p class="text-secondary text-sm sm:text-base max-w-2xl leading-relaxed font-sans">
            {resolvedDescription}
          </p>
        </div>

        <!-- Right Action Buttons -->
        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col items-start lg:items-end justify-start lg:justify-center gap-3.5 w-full sm:w-auto">
          <!-- 1-Click Interactive Copy Email Button -->
          <button 
            id="copy-email-btn" 
            type="button" 
            data-email={resolvedEmail}
            class="group w-full sm:w-auto inline-flex items-center justify-between sm:justify-start gap-3 px-4 py-3 rounded-button bg-background border border-border text-xs sm:text-sm font-sans text-[#5A2149] transition-all duration-200 cursor-pointer hover:border-[#5A2149] active:scale-95"
            title="Click to copy email address"
          >
            <span class="text-[#5A2149] font-semibold truncate">{resolvedEmail}</span>
            <span id="copy-status" class="px-2.5 py-0.5 rounded-full bg-[#5A2149] text-white text-[10px] font-bold uppercase tracking-wider transition-all shrink-0">Copy</span>
          </button>

          <!-- Book Appointment Primary Button -->
          <a 
            href="/contact" 
            class="btn-primary w-full sm:w-auto text-center justify-center text-sm sm:text-base py-3 px-6"
            data-analytics-click="Footer CTA - Schedule Appointment"
            data-astro-prefetch="hover"
          >
            <span>{client.hero?.primaryCta || "Schedule Appointment"}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white shrink-0">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. Main 4-Column Grid (Deep Plum #5A2149 Canvas with Mountain Curve Top) -->
  <div class="relative w-full">
    <!-- Mountain Curve Divider -->
    <div class="w-full leading-none overflow-hidden pointer-events-none rotate-180 relative z-10 -mb-[2px] bg-background border-none outline-none">
      <svg
        data-name="Layer 1"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 1200 160"
        preserveAspectRatio="none"
        class="block w-[calc(100%+1.3px)] h-12 sm:h-18 md:h-24 border-none outline-none"
      >
        <path
          d="M0,0V10C0,95,250,150,600,150C950,150,1200,95,1200,10V0Z"
          fill="#5A2149"
          stroke="none"
          style="fill: #5A2149; stroke: none; outline: none;"
        />
      </svg>
    </div>

    <!-- Solid Deep Plum Footer Section -->
    <div 
      class="w-full text-white pt-8 sm:pt-12 pb-12 sm:pb-16 relative z-20 border-none outline-none ring-0 -mt-[1px]"
      style="background-color: #5A2149; border: none; outline: none;"
    >
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10 text-left">
          
          <!-- Column 1: Brand & Identity (lg:col-span-4) -->
          <div class="lg:col-span-4 space-y-5">
            <!-- Logo Lockup -->
            <a href="/" class="inline-flex items-center gap-3 group" data-astro-prefetch="hover">
              {footerLogoUrl ? (
                <img src={footerLogoUrl} alt={legalName} class="h-10 sm:h-11 w-auto object-contain transition-transform group-hover:scale-105" />
              ) : (
                <div class="flex items-center gap-2.5">
                  <span class="rounded-button bg-white/15 text-[#FFD6E7] w-9 h-9 flex items-center justify-center font-sans font-bold text-base shadow-md backdrop-blur-xs border border-[#FFD6E7]/30 group-hover:text-[#FFB6D2] group-hover:border-[#FFB6D2] transition-colors duration-200">
                    {siteName.charAt(0).toUpperCase()}
                  </span>
                  <span class="font-heading text-xl font-bold tracking-tight text-[#FFFFFF] group-hover:text-[#FFB6D2] transition-colors duration-200">{siteName}</span>
                </div>
              )}
            </a>

            <!-- Bio & Mission Statement -->
            <p class="text-sm text-[#E8C9D8] leading-relaxed font-sans max-w-sm">
              {resolvedDescription}
            </p>

            <!-- Verified Badges -->
            <div class="flex items-center gap-2.5 flex-wrap">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 text-[#FFD6E7] hover:text-[#FFB6D2] hover:border-[#FFB6D2]/40 text-xs font-medium border border-[#FFD6E7]/25 backdrop-blur-xs transition-colors duration-200">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Specialty Reproductive Care
              </span>
              {resolvedGst && (
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 text-[#FFD6E7] hover:text-[#FFB6D2] hover:border-[#FFB6D2]/40 text-xs font-mono border border-[#FFD6E7]/25 backdrop-blur-xs transition-colors duration-200">
                  GST: {resolvedGst}
                </span>
              )}
            </div>

            <!-- Social Profiles -->
            {socialLinks.length > 0 && (
              <div class="space-y-2 pt-1">
                <span class="text-xs font-sans font-bold uppercase tracking-wider text-[#FFFFFF] block">
                  Connect With Us
                </span>
                <div class="flex items-center gap-2 flex-wrap">
                  {socialLinks.map((item: any) => (
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={item.platform === 'Other' && item.customPlatformName ? item.customPlatformName : item.platform}
                      title={item.platform === 'Other' && item.customPlatformName ? item.customPlatformName : item.platform}
                      class="flex items-center justify-center w-8 h-8 sm:w-8.5 sm:h-8.5 rounded-full bg-white/10 text-[#FFD6E7] hover:text-[#FFB6D2] hover:bg-white/20 border border-[#FFD6E7]/30 hover:border-[#FFB6D2]/60 shrink-0 cursor-pointer overflow-hidden p-0 transition-all duration-200 hover:scale-105 shadow-2xs [&>svg]:w-4 [&>svg]:h-4 [&>svg]:max-w-full [&>svg]:max-h-full [&>img]:w-4 [&>img]:h-4 [&>img]:object-contain"
                    >
                      {item.iconUrl ? (
                        <img src={item.iconUrl} alt={item.platform} class="w-4 h-4 object-contain" />
                      ) : (
                        <Fragment set:html={item.svgCode || getPlatformSvg(item.platform)} />
                      )}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Column 2: Navigation (lg:col-span-2) -->
          <div class="lg:col-span-2 space-y-4">
            <span class="text-xs font-sans font-bold uppercase tracking-wider text-[#FFFFFF] block">
              Navigation
            </span>
            <ul class="space-y-2.5 text-sm font-sans">
              <li><a href="/" class="text-[#E8C9D8] hover:text-[#FFB6D2] hover:translate-x-1 inline-block transition-all duration-200" data-astro-prefetch="hover">Home</a></li>
              <li><a href="/about" class="text-[#E8C9D8] hover:text-[#FFB6D2] hover:translate-x-1 inline-block transition-all duration-200" data-astro-prefetch="hover">About Us</a></li>
              <li><a href="/services" class="text-[#E8C9D8] hover:text-[#FFB6D2] hover:translate-x-1 inline-block transition-all duration-200" data-astro-prefetch="hover">Services & Treatments</a></li>
              <li><a href="/blog" class="text-[#E8C9D8] hover:text-[#FFB6D2] hover:translate-x-1 inline-block transition-all duration-200" data-astro-prefetch="hover">Clinical Blog</a></li>
              <li><a href="/contact" class="text-[#E8C9D8] hover:text-[#FFB6D2] hover:translate-x-1 inline-block transition-all duration-200" data-astro-prefetch="hover">Contact Us</a></li>
            </ul>
          </div>

          <!-- Column 3: Clinical Services (lg:col-span-3) -->
          <div class="lg:col-span-3 space-y-4">
            <span class="text-xs font-sans font-bold uppercase tracking-wider text-[#FFFFFF] block">
              Clinical Services
            </span>
            <ul class="space-y-2.5 text-sm font-sans">
              {(client.services || []).slice(0, 6).map((service: any) => (
                <li>
                  <a href={`/services/${service.slug || service.id}`} class="text-[#E8C9D8] hover:text-[#FFB6D2] hover:translate-x-1 inline-block transition-all duration-200" data-astro-prefetch="hover">
                    {service.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Column 4: Contact & Clinic Location (lg:col-span-3) -->
          <div class="lg:col-span-3 space-y-4">
            <span class="text-xs font-sans font-bold uppercase tracking-wider text-[#FFFFFF] block">
              Clinic Details
            </span>
            <div class="space-y-3 text-sm font-sans text-[#E8C9D8]">
              <!-- Address -->
              <div class="flex items-start gap-2.5">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#FFD6E7] shrink-0 mt-1">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
                <span class="leading-relaxed hover:text-[#FFB6D2] transition-colors duration-200">{formattedAddress}</span>
              </div>

              <!-- Email -->
              <div class="flex items-center gap-2.5">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#FFD6E7] shrink-0">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
                <a href={`mailto:${resolvedEmail}`} class="text-[#E8C9D8] hover:text-[#FFB6D2] hover:underline transition-colors duration-200 font-semibold truncate">{resolvedEmail}</a>
              </div>

              <!-- Phone -->
              <div class="flex items-center gap-2.5">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#FFD6E7] shrink-0">
                  <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.68A2 2 0 012.18 1h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.91 8.1a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"/>
                </svg>
                <a href={`tel:${resolvedPhone.replace(/\s+/g, '')}`} class="text-[#E8C9D8] hover:text-[#FFB6D2] hover:underline transition-colors duration-200 font-semibold">{resolvedPhone}</a>
              </div>

              <!-- Hours Badge -->
              <div class="pt-1">
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-white/10 text-xs text-[#FFD6E7] hover:text-[#FFB6D2] font-mono font-medium border border-[#FFD6E7]/25 hover:border-[#FFB6D2]/40 transition-colors duration-200">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  Mon - Sat: 9:00 AM - 7:00 PM IST
                </span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- 3. Bottom Copyright Bar (With Mobile Safe Padding) -->
  <div 
    class="text-[#E8C9D8] border-t border-[#FFD6E7]/15 pt-6 pb-28 lg:pb-8 px-4 sm:px-6 lg:px-8 relative z-20"
    style="background-color: #5A2149;"
  >
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-sans text-[#E8C9D8] text-center md:text-left">
      <div>
        <span>&copy; {new Date().getFullYear()} <span class="text-[#FFD6E7] hover:text-[#FFB6D2] transition-colors cursor-pointer">{legalName}</span>. All rights reserved.</span>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/sitemap.xml" target="_blank" class="text-[#E8C9D8] hover:text-[#FFB6D2] transition-colors duration-200">Sitemap</a>
        <span class="text-[#FFD6E7]/40">•</span>
        <a href="/rss.xml" target="_blank" class="text-[#E8C9D8] hover:text-[#FFB6D2] transition-colors duration-200">RSS Feed</a>
        <span class="text-[#FFD6E7]/40">•</span>
        <a href="/robots.txt" target="_blank" class="text-[#E8C9D8] hover:text-[#FFB6D2] transition-colors duration-200">Robots</a>
      </div>
    </div>
  </div>

</footer>

<script>
  const initFooterScripts = () => {
    const copyEmailBtn = document.getElementById('copy-email-btn');
    const copyStatus = document.getElementById('copy-status');

    if (copyEmailBtn && copyStatus) {
      copyEmailBtn.addEventListener('click', () => {
        const email = copyEmailBtn.getAttribute('data-email');
        if (email) {
          navigator.clipboard.writeText(email).then(() => {
            copyStatus.textContent = 'Copied!';
            copyStatus.classList.add('bg-emerald-600', 'text-white');
            copyStatus.classList.remove('bg-[#5A2149]', 'text-white');
            setTimeout(() => {
              copyStatus.textContent = 'Copy';
              copyStatus.classList.remove('bg-emerald-600', 'text-white');
              copyStatus.classList.add('bg-[#5A2149]', 'text-white');
            }, 2500);
          }).catch(err => {
            console.error('Failed to copy email:', err);
          });
        }
      });
    }
  };

  document.addEventListener('astro:page-load', initFooterScripts);
</script>
