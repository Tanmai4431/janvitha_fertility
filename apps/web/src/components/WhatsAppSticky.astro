---
import { getSiteSettings, urlFor } from '../utils/sanity';
import client from '../../../../client.json';

interface Props {
  primaryPhone?: string;
}

const { primaryPhone } = Astro.props;
const siteSettings = await getSiteSettings();

// 1. Dynamic Toggle Resolution (Sanity Studio CMS || client.json fallback)
const enableWhatsAppWidget = siteSettings?.enableWhatsAppWidget ?? (client.settings as any)?.enableWhatsAppWidget ?? true;

// 2. Resolve Target Phone Number & Clean Digits
const targetPhone = siteSettings?.whatsAppPhone || primaryPhone || siteSettings?.primaryPhone || client.contact?.primaryPhone || '+919491309988';
const cleanWa = targetPhone.replace(/[^0-9]/g, '');

// 3. Resolve Custom Pre-filled Message, Status Badge, & Icon Options
const customMessage = siteSettings?.whatsAppMessage || `Hi ${client.business.name}, I would like to schedule an appointment.`;
const encodedMessage = encodeURIComponent(customMessage);
const showActiveStatus = siteSettings?.whatsAppShowActiveStatus ?? true;
const iconType = siteSettings?.whatsAppIconType || 'default';
const customSvg = siteSettings?.whatsAppCustomSvg || null;

let customImageUrl = '';
if (siteSettings?.whatsAppCustomImage) {
  try {
    customImageUrl = urlFor(siteSettings.whatsAppCustomImage).width(120).height(120).url();
  } catch (e) {}
}

// 4. Strict Omission Rule: If toggle is OFF or phone is missing, render NOTHING
const shouldRender = enableWhatsAppWidget && Boolean(cleanWa);
---

{shouldRender && (
  <div 
    id="desktop-whatsapp-wrapper"
    class="fixed bottom-6 right-6 z-50 hidden nav-desktop:flex items-center justify-center select-none"
    data-animate="fade-up"
  >
    <a
      href={`https://wa.me/${cleanWa}?text=${encodedMessage}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat on WhatsApp"
      title={`Chat on WhatsApp with ${client.business.name}`}
      class="relative w-14 h-14 rounded-full bg-surface border border-border text-[#25D366] shadow-md hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-200 flex items-center justify-center group cursor-pointer overflow-visible"
      data-analytics-click="DesktopSticky - WhatsApp"
    >
      <!-- Glowing Online Pulse Ring Indicator (Controlled by whatsAppShowActiveStatus) -->
      {showActiveStatus && (
        <>
          <span class="absolute top-0 right-0 w-3.5 h-3.5 rounded-full bg-[#25D366] border-2 border-white ring-2 ring-emerald-400/30 z-20" />
          <span class="absolute top-0 right-0 w-3.5 h-3.5 rounded-full bg-[#25D366] animate-ping z-10" />
        </>
      )}

      <!-- Dynamic Icon Renderer: Custom Image || Custom SVG || Default WhatsApp Icon -->
      {iconType === 'customImage' && customImageUrl ? (
        <img src={customImageUrl} alt="WhatsApp Chat" class="w-7 h-7 object-contain rounded-full transition-transform duration-300 group-hover:scale-110" />
      ) : iconType === 'customSvg' && customSvg ? (
        <div class="w-6 h-6 flex items-center justify-center text-[#25D366] transition-transform duration-300 group-hover:scale-110" set:html={customSvg} />
      ) : (
        <svg viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-[#25D366] transition-transform duration-300 group-hover:scale-110">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
      )}
    </a>
  </div>
)}
