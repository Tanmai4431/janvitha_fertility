---
import Layout from '../../layouts/Layout.astro';
import { sanityClient, urlFor, getSiteSettings } from '../../utils/sanity';
import PortableTextRenderer from '../../components/PortableTextRenderer';
import Breadcrumbs from '../../components/ui/navigation/Breadcrumbs.astro';
import { BlogCard, type BlogCardPost } from '../../components/ui/BlogCard';
import { 
  ArrowLeft, 
  Clock, 
  Tag, 
  ShieldCheck, 
  CheckCircle2, 
  Phone, 
  ArrowRight, 
  Stethoscope,
  Award,
  HelpCircle
} from 'lucide-react';
import client from '../../../../../client.json';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const siteSettings = await getSiteSettings();
const siteName = siteSettings?.name || client.business.name;
const specialist = client.business.specialist;
const defaultAuthorName = specialist?.name || "Dr. P. Bharathi";
const defaultAuthorRole = specialist?.designation || "Consultant Obstetrician & Gynaecologist";
const doctorImage = specialist?.image || "https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=800&q=80";
const primaryPhone = client.contact.primaryPhone || "+91 81214 49988";

// Comprehensive fallback clinical articles for Janvithas Fertility Center
const sampleFallbackPostsMap: Record<string, any> = {
  'understanding-when-to-visit-a-fertility-specialist': {
    title: 'Understanding When to Visit a Fertility Specialist: Key Signs & Guidelines',
    slug: { current: 'understanding-when-to-visit-a-fertility-specialist' },
    category: 'Fertility Evaluation',
    readTime: '4 min read',
    publishedAt: new Date(Date.now() - 86400000 * 2).toISOString(),
    excerpt: 'Comprehensive clinical guidance on when couples and individuals should consider early fertility diagnostics, ovarian reserve testing, and dual partner semen evaluation.',
    mainImageUrl: 'https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=1200&q=80',
    author: defaultAuthorName,
    authorRole: defaultAuthorRole,
    tags: ['Fertility Assessment', 'Women Health', 'Reproductive Care', 'Ovarian Reserve'],
    isFeatured: true,
    keyTakeaways: [
      'Couples trying for over 12 months (or 6 months if female partner is over 35) should seek timely fertility evaluation.',
      'Comprehensive dual evaluation of both partners simultaneously ensures faster diagnosis and targeted care.',
      'Early hormonal testing (AMH, FSH) and pelvic ultrasound pinpoint ovarian reserve and uterine health.'
    ],
    sections: [
      {
        id: 'why-early-evaluation-matters',
        title: 'Why Early Evaluation Matters in Reproductive Medicine',
        content: `
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-sans">
            Deciding when to consult a fertility specialist is a pivotal first step toward building your family. Many couples delay seeking advice due to uncertainty or anxiety, but proactive assessment provides clear answers and opens the door to gentle, minimally invasive treatment protocols.
          </p>
        `
      },
      {
        id: 'clinical-guidelines-timelines',
        title: 'Recommended Timeline for Fertility Consultation',
        content: `
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-sans mb-4">
            Reproductive specialists recommend scheduling a comprehensive consultation based on the female partner's age and the duration of trying:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 my-6">
            <div class="p-4 rounded-2xl bg-[#FFF0F6] border border-[#FADCEB] space-y-1">
              <span class="text-xs font-label font-bold text-[#E4006E] uppercase">Under 35 Years</span>
              <p class="text-sm font-heading font-bold text-[#1A0B3C]">12 Months</p>
              <p class="text-xs text-secondary font-sans">Of regular unprotected intercourse without conception.</p>
            </div>
            <div class="p-4 rounded-2xl bg-[#FAF0F8] border border-[#EEDBF2] space-y-1">
              <span class="text-xs font-label font-bold text-[#853676] uppercase">Age 35 – 39 Years</span>
              <p class="text-sm font-heading font-bold text-[#1A0B3C]">6 Months</p>
              <p class="text-xs text-secondary font-sans">Due to natural age-related decline in ovarian egg reserve.</p>
            </div>
            <div class="p-4 rounded-2xl bg-[#FFF0F6] border border-[#FADCEB] space-y-1">
              <span class="text-xs font-label font-bold text-[#E4006E] uppercase">Age 40 & Above</span>
              <p class="text-sm font-heading font-bold text-[#1A0B3C]">Immediate</p>
              <p class="text-xs text-secondary font-sans">Immediate evaluation upon deciding to pursue parenthood.</p>
            </div>
          </div>
        `
      },
      {
        id: 'symptoms-health-indicators',
        title: 'Key Symptoms and Medical Indicators',
        content: `
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-sans mb-4">
            Regardless of duration, you should schedule a clinical consultation promptly if you experience any of the following symptoms:
          </p>
          <ul class="space-y-3 font-sans text-gray-700 text-sm sm:text-base">
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-[#FFF0F6] text-[#E4006E] flex items-center justify-center shrink-0 mt-0.5 border border-rose-100 font-bold text-xs">✓</div>
              <span><strong>Irregular or Absent Cycles:</strong> Indicates anovulation, PCOS, or hormonal imbalances.</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-[#FFF0F6] text-[#E4006E] flex items-center justify-center shrink-0 mt-0.5 border border-rose-100 font-bold text-xs">✓</div>
              <span><strong>Severe Pelvic Pain (Dysmenorrhea):</strong> Frequent indicator of endometriosis, fibroids, or pelvic adhesions.</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-[#FFF0F6] text-[#E4006E] flex items-center justify-center shrink-0 mt-0.5 border border-rose-100 font-bold text-xs">✓</div>
              <span><strong>Male Factor Indications:</strong> History of varicocele, testicular surgery, or abnormal semen parameters.</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-[#FFF0F6] text-[#E4006E] flex items-center justify-center shrink-0 mt-0.5 border border-rose-100 font-bold text-xs">✓</div>
              <span><strong>Recurrent Pregnancy Loss:</strong> Two or more consecutive miscarriages require genetic and immunological testing.</span>
            </li>
          </ul>
        `
      },
      {
        id: 'initial-consultation-steps',
        title: 'What to Expect During Your Initial Consultation at Janvithas',
        content: `
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-sans mb-4">
            At Janvithas Fertility Center, Dr. P. Bharathi conducts an empathetic, transparent, and structured dual-partner diagnostic workflow:
          </p>
          <div class="space-y-3 font-sans">
            <div class="p-4 rounded-2xl bg-white border border-[#FADCEB] flex items-start gap-3 shadow-xs">
              <span class="w-7 h-7 rounded-full bg-[#E4006E] text-white flex items-center justify-center shrink-0 font-bold text-xs">1</span>
              <div>
                <h4 class="font-heading font-bold text-sm text-[#1A0B3C]">Comprehensive Medical & Fertility History</h4>
                <p class="text-xs text-secondary mt-0.5">Evaluating menstrual regularity, prior pregnancies, lifestyle factors, and surgical history.</p>
              </div>
            </div>
            <div class="p-4 rounded-2xl bg-white border border-[#FADCEB] flex items-start gap-3 shadow-xs">
              <span class="w-7 h-7 rounded-full bg-[#E4006E] text-white flex items-center justify-center shrink-0 font-bold text-xs">2</span>
              <div>
                <h4 class="font-heading font-bold text-sm text-[#1A0B3C]">High-Resolution Pelvic Ultrasound</h4>
                <p class="text-xs text-secondary mt-0.5">Antral Follicle Count (AFC) assessment and detailed uterine cavity mapping.</p>
              </div>
            </div>
            <div class="p-4 rounded-2xl bg-white border border-[#FADCEB] flex items-start gap-3 shadow-xs">
              <span class="w-7 h-7 rounded-full bg-[#E4006E] text-white flex items-center justify-center shrink-0 font-bold text-xs">3</span>
              <div>
                <h4 class="font-heading font-bold text-sm text-[#1A0B3C]">Ovarian Reserve Hormonal Panel (AMH)</h4>
                <p class="text-xs text-secondary mt-0.5">Precise measurement of egg reserve and endocrine markers (TSH, Prolactin).</p>
              </div>
            </div>
            <div class="p-4 rounded-2xl bg-white border border-[#FADCEB] flex items-start gap-3 shadow-xs">
              <span class="w-7 h-7 rounded-full bg-[#E4006E] text-white flex items-center justify-center shrink-0 font-bold text-xs">4</span>
              <div>
                <h4 class="font-heading font-bold text-sm text-[#1A0B3C]">Computer-Assisted Semen Analysis (CASA)</h4>
                <p class="text-xs text-secondary mt-0.5">Strict Kruger morphology, progressive motility, and total motile sperm count.</p>
              </div>
            </div>
          </div>
        `
      }
    ]
  },
  'comparing-iui-ivf-and-icsi-protocols': {
    title: 'Advanced Assisted Reproduction: Comparing IUI, IVF, and ICSI Protocols',
    slug: { current: 'comparing-iui-ivf-and-icsi-protocols' },
    category: 'Assisted Reproduction',
    readTime: '6 min read',
    publishedAt: new Date(Date.now() - 86400000 * 5).toISOString(),
    excerpt: 'A clear clinical comparison of modern assisted reproductive options, from gentle IUI insemination to micromanipulated ICSI and PICSI techniques.',
    mainImageUrl: 'https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=1200&q=80',
    author: defaultAuthorName,
    authorRole: defaultAuthorRole,
    tags: ['IVF Care', 'ICSI', 'IUI Treatment', 'Assisted Conception'],
    isFeatured: false,
    keyTakeaways: [
      'IUI is an excellent first-line, minimally invasive option for mild male factor or unexplained infertility.',
      'IVF provides high pregnancy rates for tubal blockage, diminished reserve, and extended unexplained cases.',
      'ICSI & PICSI resolve severe sperm abnormalities through single-sperm micromanipulation and physiological selection.'
    ],
    sections: [
      {
        id: 'understanding-art-pathways',
        title: 'Understanding Modern Assisted Reproductive Technologies (ART)',
        content: `
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-sans">
            Assisted reproductive technologies offer multiple customized treatment pathways depending on the specific root cause of infertility. By understanding the differences between IUI, IVF, and ICSI, couples can embark on their journey with clarity and confidence.
          </p>
        `
      },
      {
        id: 'iui-protocol',
        title: '1. Intrauterine Insemination (IUI): Gentle First-Line Care',
        content: `
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-sans mb-3">
            IUI is a gentle, minimally invasive outpatient procedure where concentrated, washed sperm is placed directly into the uterine cavity near ovulation.
          </p>
          <div class="p-4 rounded-2xl bg-[#FFF0F6] border border-[#FADCEB] space-y-2">
            <h4 class="font-heading font-bold text-sm text-[#1A0B3C]">Best Suited For:</h4>
            <ul class="text-xs sm:text-sm text-secondary font-sans list-disc list-inside space-y-1">
              <li>Mild male factor subfertility or cervical mucus hostility.</li>
              <li>Ovulatory dysfunction responsive to mild oral induction.</li>
              <li>Couples with healthy fallopian tubes and adequate sperm counts.</li>
            </ul>
          </div>
        `
      },
      {
        id: 'ivf-protocol',
        title: '2. In Vitro Fertilization (IVF): The Gold Standard',
        content: `
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-sans mb-3">
            In standard IVF, eggs are retrieved from the ovaries after controlled stimulation and incubated with prepared sperm in clean-room laboratories for natural fertilization.
          </p>
          <div class="p-4 rounded-2xl bg-[#FAF0F8] border border-[#EEDBF2] space-y-2">
            <h4 class="font-heading font-bold text-sm text-[#1A0B3C]">Best Suited For:</h4>
            <ul class="text-xs sm:text-sm text-secondary font-sans list-disc list-inside space-y-1">
              <li>Bilateral tubal blockage or severe pelvic adhesions.</li>
              <li>Moderate to severe endometriosis.</li>
              <li>Unexplained infertility after unsuccessful IUI attempts.</li>
            </ul>
          </div>
        `
      },
      {
        id: 'icsi-picsi-protocol',
        title: '3. ICSI & Physiological PICSI: Micromanipulation Precision',
        content: `
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-sans mb-3">
            ICSI involves selecting a single healthy sperm and injecting it directly into the cytoplasm of a mature egg using precision micromanipulators under high-power magnification.
          </p>
          <div class="p-4 rounded-2xl bg-white border border-[#FADCEB] space-y-2 shadow-xs">
            <h4 class="font-heading font-bold text-sm text-[#E4006E]">Advanced PICSI Advantage:</h4>
            <p class="text-xs sm:text-sm text-secondary font-sans leading-relaxed">
              PICSI adds hyaluronan binding to ensure only physiologically mature sperm with intact DNA integrity are selected for injection, significantly boosting implantation rates.
            </p>
          </div>
        `
      }
    ]
  },
  'role-of-blastocyst-culture-day-5-embryo-incubation': {
    title: 'The Role of Blastocyst Culture & Day-5 Embryo Incubation in IVF Success',
    slug: { current: 'role-of-blastocyst-culture-day-5-embryo-incubation' },
    category: 'Embryology',
    readTime: '5 min read',
    publishedAt: new Date(Date.now() - 86400000 * 9).toISOString(),
    excerpt: 'How extended Day-5 embryology culture and physiological selection significantly enhance single-embryo transfer implantation success rates.',
    mainImageUrl: 'https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=1200&q=80',
    author: defaultAuthorName,
    authorRole: defaultAuthorRole,
    tags: ['Blastocyst', 'Embryology', 'IVF Success', 'Single Embryo Transfer'],
    isFeatured: true,
    keyTakeaways: [
      'Extended Day-5 blastocyst culture replicates natural uterine timing, allowing self-selection of robust embryos.',
      'Blastocyst transfer achieves implantation rates of up to 60-70% per single embryo transfer.',
      'Significantly reduces the incidence of high-risk multiple pregnancies while maintaining high pregnancy rates.'
    ],
    sections: [
      {
        id: 'why-blastocyst-matters',
        title: 'The Shift from Day-3 to Day-5 Blastocyst Culture',
        content: `
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-sans">
            Culturing embryos to Day 5 or Day 6 allows natural biological self-selection. Only embryos with genomic activation and chromosomal viability successfully reach the expanded 100+ cell blastocyst stage.
          </p>
        `
      },
      {
        id: 'uterine-synchronization',
        title: 'Perfect Endometrial Synchronization',
        content: `
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-sans mb-3">
            In natural conception, embryos enter the uterus on Day 5. Transferring at the blastocyst stage aligns precisely with the uterine window of receptivity, maximizing implantation efficiency.
          </p>
        `
      }
    ]
  },
  'male-factor-fertility-evaluation-semen-analysis': {
    title: 'Male Factor Fertility Evaluation: Semen Analysis & Advanced Diagnostics',
    slug: { current: 'male-factor-fertility-evaluation-semen-analysis' },
    category: 'Male Fertility',
    readTime: '4 min read',
    publishedAt: new Date(Date.now() - 86400000 * 14).toISOString(),
    excerpt: 'Understanding semen parameter diagnostics, sperm DNA fragmentation testing, and modern treatment options for male reproductive health.',
    mainImageUrl: 'https://images.unsplash.com/photo-1581594693702-fbdc51b2763b?auto=format&fit=crop&w=1200&q=80',
    author: defaultAuthorName,
    authorRole: defaultAuthorRole,
    tags: ['Male Fertility', 'Semen Analysis', 'PICSI', 'Andrology'],
    isFeatured: false,
    keyTakeaways: [
      'Male-factor issues contribute to approximately 40-50% of all infertility cases.',
      'Standard semen analysis evaluates concentration, progressive motility, and strict morphology.',
      'Advanced sperm DNA Fragmentation Index (DFI) testing identifies hidden oxidative stress factors.'
    ],
    sections: [
      {
        id: 'dual-evaluation',
        title: 'Shared Responsibility in Fertility',
        content: `
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-sans">
            Fertility is equally balanced between both partners. Timely male-factor evaluation with Computer-Assisted Semen Analysis (CASA) and DNA fragmentation screening ensures accurate diagnosis without delays.
          </p>
        `
      }
    ]
  },
  'fertility-preservation-protecting-future-family-options': {
    title: 'Fertility Preservation: Protecting Future Family Options with Vitrification',
    slug: { current: 'fertility-preservation-protecting-future-family-options' },
    category: 'Fertility Preservation',
    readTime: '5 min read',
    publishedAt: new Date(Date.now() - 86400000 * 20).toISOString(),
    excerpt: 'A comprehensive guide to elective and medical egg freezing, sperm cryopreservation, and advanced ultra-rapid vitrification technologies.',
    mainImageUrl: 'https://images.unsplash.com/photo-1532938911079-1b06ac7ceec7?auto=format&fit=crop&w=1200&q=80',
    author: defaultAuthorName,
    authorRole: defaultAuthorRole,
    tags: ['Cryopreservation', 'Egg Freezing', 'Family Planning', 'Vitrification'],
    isFeatured: true,
    keyTakeaways: [
      'Vitrification is an ultra-rapid flash-freezing technique that avoids ice crystal formation, achieving >90% post-thaw survival.',
      'Elective egg freezing allows women to preserve healthy oocytes during their peak reproductive years.',
      'Medical cryopreservation preserves fertility prior to chemotherapy, radiation, or pelvic surgeries.'
    ],
    sections: [
      {
        id: 'vitrification-technology',
        title: 'The Science of Flash-Freezing Vitrification',
        content: `
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-sans">
            Vitrification rapidly cools reproductive cells at -20,000°C per minute into a glass-like solid state, preventing ice crystals and delivering over 90-95% post-thaw survival rates.
          </p>
        `
      }
    ]
  },
};

let post: any = null;
try {
  post = await sanityClient.fetch(
    `*[_type == "post" && slug.current == $slug][0] {
      title,
      "slug": slug.current,
      category,
      readTime,
      isFeatured,
      videoUrl,
      "videoFileUrl": videoFile.asset->url,
      author,
      authorRole,
      "authorAvatarUrl": authorAvatar.asset->url,
      tags,
      excerpt,
      publishedAt,
      mainImage,
      body,
      seo,
      _updatedAt
    }`,
    { slug }
  );
} catch (e) {
  console.error(`Failed to fetch post detail for slug: ${slug}`, e);
}

// Fallback to sample post if not found in Sanity CMS
if (!post && sampleFallbackPostsMap[slug]) {
  post = sampleFallbackPostsMap[slug];
}

if (!post) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
  });
}

// Format URLs & Metadata
let mainImageUrl = post.mainImageUrl || '';
if (!mainImageUrl && post.mainImage) {
  try {
    mainImageUrl = urlFor(post.mainImage).width(1200).height(675).format('webp').url();
  } catch (e) {
    console.error('Failed to format post detail image:', e);
  }
}

// SEO & Share Image Resolution
const seoTitle = post.seo?.metaTitle || `${post.title} | ${siteName}`;
const seoDescription = post.seo?.metaDescription || post.excerpt || client.seo.defaultDescription;
let seoImage = client.seo.defaultShareImage;
if (post.seo?.shareImage) {
  try {
    seoImage = urlFor(post.seo.shareImage).width(1200).height(630).format('jpg').url();
  } catch (e) {}
} else if (mainImageUrl) {
  seoImage = mainImageUrl;
}

// Format Date & Read Time
const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
    })
  : 'Recent Publication';

const displayReadTime = post.readTime || '4 min read';
const categoryName = post.category || 'Clinical Guidance';
const keyTakeaways = post.keyTakeaways || [
  'Personalized clinical assessment tailored to each couple’s unique medical history.',
  'Evidence-based assisted reproduction with transparent ethical protocols.',
  'Continuous support from initial consultation through prenatal monitoring.'
];

const sections = post.sections || [];

// Fetch Related Posts from Sanity
let rawRelated: any[] = [];
try {
  rawRelated = await sanityClient.fetch(
    `*[_type == "post" && slug.current != $slug] | order(publishedAt desc)[0...3] {
      title,
      "slug": slug.current,
      category,
      readTime,
      isFeatured,
      videoUrl,
      "videoFileUrl": videoFile.asset->url,
      author,
      authorRole,
      "authorAvatarUrl": authorAvatar.asset->url,
      tags,
      excerpt,
      publishedAt,
      mainImage
    }`,
    { slug }
  );
} catch (e) {
  console.error("Failed to fetch related posts:", e);
}

const mappedRelatedPosts: BlogCardPost[] = (rawRelated || []).map((p) => {
  let imgUrl = '';
  if (p.mainImage) {
    try {
      imgUrl = urlFor(p.mainImage).width(800).height(450).format('webp').url();
    } catch (e) {}
  }
  return {
    title: p.title || 'Untitled Article',
    slug: p.slug || '',
    category: p.category || 'Clinical Guidance',
    readTime: p.readTime || '4 min read',
    publishedAt: p.publishedAt || new Date().toISOString(),
    excerpt: p.excerpt || 'Explore key clinical findings from our specialists.',
    mainImageUrl: imgUrl,
    videoUrl: p.videoFileUrl || p.videoUrl || undefined,
    authorName: p.author || defaultAuthorName,
    authorRole: p.authorRole || defaultAuthorRole,
    authorAvatarUrl: p.authorAvatarUrl || undefined,
    tags: p.tags || ['Fertility Care', 'Reproductive Care'],
    isFeatured: p.isFeatured || false,
  };
});

// Fallbacks for related posts if Sanity has fewer items
const fallbackRelatedList: BlogCardPost[] = Object.values(sampleFallbackPostsMap)
  .filter((sp) => sp.slug.current !== slug)
  .map((sp) => ({
    title: sp.title,
    slug: sp.slug.current,
    category: sp.category,
    readTime: sp.readTime,
    publishedAt: sp.publishedAt,
    excerpt: sp.excerpt,
    mainImageUrl: sp.mainImageUrl,
    videoUrl: sp.videoUrl,
    authorName: sp.author,
    authorRole: sp.authorRole,
    tags: sp.tags,
    isFeatured: sp.isFeatured,
  }));

const finalRelatedPosts: BlogCardPost[] = [
  ...mappedRelatedPosts,
  ...fallbackRelatedList.filter((fr) => !mappedRelatedPosts.some((mr) => mr.slug === fr.slug)),
].slice(0, 3);
---

<Layout
  title={seoTitle}
  description={seoDescription}
  shareImage={seoImage}
  type="article"
  publishedAt={post.publishedAt}
  updatedAt={post._updatedAt}
  author={post.author || defaultAuthorName}
>
  <main class="flex-grow py-4 sm:py-6 md:py-8 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 sm:space-y-8">
      
      {/* Top Header Navigation & Action Bar */}
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <Breadcrumbs 
          items={[
            { label: 'Publications', href: '/blog' }, 
            { label: post.title }
          ]} 
          className="justify-start mb-0" 
        />

        <a
          href="/blog"
          class="inline-flex items-center gap-2 self-start sm:self-auto px-4 py-2 rounded-full border-2 border-[#FDDCEB] bg-white text-xs font-sans font-bold uppercase tracking-wider text-[#1A0B3C] hover:border-[#E4006E] hover:text-[#E4006E] hover:bg-[#FFF0F6] transition-all shadow-xs shrink-0"
          data-astro-prefetch="hover"
        >
          <ArrowLeft className="w-3.5 h-3.5 text-[#E4006E]" />
          <span>Back to All Publications</span>
        </a>
      </div>

      {/* =========================================================================
          HERO ARTICLE BANNER CARD (Editorial Headline & Metadata)
         ========================================================================= */}
      <section 
        class="rounded-[32px] sm:rounded-[36px] bg-[#FFFDFC] border-2 border-[#FDDCEB] p-6 sm:p-9 lg:p-12 shadow-[0_4px_30px_rgba(228,0,110,0.04)] space-y-6 sm:space-y-8"
        data-animate="fade-up"
      >
        {/* Category, Read Time, and Verification Badges */}
        <div class="flex items-center gap-2.5 flex-wrap">
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-[#FFF0F6] border border-[#FADCEB] text-[#E4006E] font-label font-bold text-xs uppercase tracking-wider">
            <Tag className="w-3.5 h-3.5" />
            {categoryName}
          </span>

          <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white border border-[#FADCEB] text-secondary text-xs font-sans font-medium">
            <Clock className="w-3.5 h-3.5 text-[#E4006E]" />
            {displayReadTime}
          </span>

          <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold">
            <ShieldCheck className="w-4 h-4 text-emerald-600" />
            Medically Reviewed
          </span>
        </div>

        {/* Display Title */}
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-heading font-bold tracking-tight text-[#1A0B3C] leading-tight max-w-5xl">
          {post.title}
        </h1>

        {/* Excerpt Callout */}
        {post.excerpt && (
          <div class="p-5 sm:p-6 rounded-[22px] bg-[#FFF0F6] border-l-4 border-[#E4006E] text-[#1A0B3C] text-sm sm:text-base md:text-lg leading-relaxed font-sans shadow-xs">
            <p class="font-medium">
              {post.excerpt}
            </p>
          </div>
        )}

        {/* Author Byline & Date Strip */}
        <div class="pt-4 border-t border-[#FADCEB] flex items-center justify-between gap-4 flex-wrap">
          <div class="flex items-center gap-3.5">
            <img
              src={post.authorAvatarUrl || doctorImage}
              alt={post.author || defaultAuthorName}
              class="w-12 h-12 rounded-full object-cover object-top border-2 border-[#FADCEB] ring-2 ring-[#E4006E]/20 shadow-xs"
            />
            <div>
              <div class="font-heading font-bold text-sm sm:text-base text-[#1A0B3C]">
                {post.author || defaultAuthorName}
              </div>
              <div class="text-xs text-secondary font-sans">
                {post.authorRole || defaultAuthorRole} • <span class="text-gray-500 font-medium">Published {formattedDate}</span>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <a
              href="/contact"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-[#E4006E] hover:bg-[#6B21A8] text-white font-sans font-bold text-xs shadow-xs transition-all"
            >
              <span>Consult Doctor</span>
              <ArrowRight className="w-3.5 h-3.5" />
            </a>
          </div>
        </div>

        {/* Hero Featured Visual */}
        {post.videoFileUrl || post.videoUrl ? (
          <div class="rounded-[24px] sm:rounded-[28px] overflow-hidden shadow-md border-2 border-[#FDDCEB] bg-black aspect-video max-h-[500px] w-full">
            {post.videoFileUrl ? (
              <video src={post.videoFileUrl} controls class="w-full h-full object-contain" />
            ) : (
              <iframe src={post.videoUrl} title={post.title} class="w-full h-full border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen />
            )}
          </div>
        ) : mainImageUrl ? (
          <div class="rounded-[24px] sm:rounded-[28px] overflow-hidden shadow-md border-2 border-[#FDDCEB] max-h-[480px] w-full">
            <img src={mainImageUrl} alt={post.title} class="w-full h-full object-cover" loading="lazy" />
          </div>
        ) : null}
      </section>

      {/* =========================================================================
          2-COLUMN EDITORIAL CONTENT & STICKY CLINICAL SIDEBAR
         ========================================================================= */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        
        {/* =========================================================================
            LEFT / MAIN COLUMN: Rich Article Content (8 cols)
           ========================================================================= */}
        <article 
          class="lg:col-span-8 rounded-[32px] sm:rounded-[36px] bg-[#FFFDFC] border-2 border-[#FDDCEB] p-6 sm:p-9 lg:p-10 shadow-[0_4px_30px_rgba(228,0,110,0.04)] space-y-8"
          data-animate="fade-up"
        >
          {/* Render Sections if structured */}
          {sections && sections.length > 0 ? (
            <div class="space-y-8">
              {sections.map((sec: any, idx: number) => (
                <section id={sec.id} class="space-y-4 scroll-mt-28">
                  <div class="flex items-center gap-3">
                    <span class="w-8 h-8 rounded-full bg-[#FFF0F6] text-[#E4006E] border border-[#FADCEB] flex items-center justify-center font-heading font-bold text-xs shrink-0">
                      0{idx + 1}
                    </span>
                    <h2 class="text-xl sm:text-2xl font-heading font-bold text-[#1A0B3C]">
                      {sec.title}
                    </h2>
                  </div>
                  <div class="pl-0 sm:pl-11" set:html={sec.content} />
                </section>
              ))}
            </div>
          ) : (
            /* Fallback or Portable Text Body */
            <div class="space-y-6">
              {post.body && Array.isArray(post.body) ? (
                <PortableTextRenderer client:load value={post.body} />
              ) : post.bodyHtml ? (
                <div class="prose prose-lg max-w-none text-[#1A0B3C] font-sans leading-relaxed space-y-6 prose-headings:font-heading prose-headings:font-bold prose-headings:text-[#1A0B3C] prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-8 prose-h2:mb-4 prose-h2:border-b prose-h2:border-[#FADCEB] prose-h2:pb-2 prose-h3:text-xl prose-h3:text-[#853676] prose-p:text-gray-700 prose-p:leading-relaxed prose-li:text-gray-700 prose-blockquote:border-l-4 prose-blockquote:border-[#E4006E] prose-blockquote:bg-[#FFF0F6] prose-blockquote:p-4 prose-blockquote:rounded-r-[16px] prose-blockquote:italic prose-blockquote:text-[#1A0B3C]" set:html={post.bodyHtml} />
              ) : typeof post.body === 'string' ? (
                <div set:html={post.body} />
              ) : (
                <p class="text-secondary text-sm">
                  Detailed clinical evaluation and patient guidance available at Janvithas Fertility Center.
                </p>
              )}
            </div>
          )}

          {/* Article Topics / Tags */}
          {post.tags && Array.isArray(post.tags) && post.tags.length > 0 && (
            <div class="pt-6 border-t border-[#FADCEB] flex items-center gap-2 flex-wrap">
              <span class="font-label font-bold uppercase tracking-wider text-[#1A0B3C] text-xs">
                Related Topics:
              </span>
              {post.tags.map((tag: string) => (
                <span class="px-3 py-1 rounded-full bg-[#FFF0F6] border border-[#FADCEB] text-xs font-sans text-[#E4006E] font-medium">
                  #{tag}
                </span>
              ))}
            </div>
          )}

          {/* In-Article Consultation Callout Banner */}
          <div class="p-6 sm:p-7 rounded-[26px] bg-gradient-to-r from-[#FFF0F6] via-white to-[#FAF0F8] border-2 border-[#FDDCEB] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5 shadow-xs">
            <div class="space-y-1 max-w-md">
              <span class="text-[11px] font-label font-bold uppercase tracking-wider text-[#E4006E]">
                NEED PERSONALIZED GUIDANCE?
              </span>
              <h4 class="text-lg font-heading font-bold text-[#1A0B3C]">
                Speak directly with Dr. P. Bharathi
              </h4>
              <p class="text-xs text-secondary font-sans">
                Confidential fertility assessments and personalized care protocols at Janvithas.
              </p>
            </div>

            <a
              href="/contact"
              class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-[#E4006E] hover:bg-[#6B21A8] text-white font-sans font-bold text-xs shadow-md transition-all shrink-0"
            >
              <span>Book Appointment</span>
              <ArrowRight className="w-3.5 h-3.5" />
            </a>
          </div>

        </article>

        {/* =========================================================================
            RIGHT / SIDEBAR COLUMN: Sticky Clinical Tools & Specialist Info (4 cols)
           ========================================================================= */}
        <aside class="lg:col-span-4 space-y-6 sticky top-24">
          
          {/* Card 1: Key Clinical Takeaways */}
          {keyTakeaways && keyTakeaways.length > 0 && (
            <div class="rounded-[28px] bg-[#FAF0F8] border-2 border-[#EEDBF2] p-5 sm:p-6 shadow-xs space-y-3.5" data-animate="fade-up">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full bg-[#853676] text-white flex items-center justify-center shrink-0">
                  <CheckCircle2 className="w-4 h-4" />
                </div>
                <h3 class="font-heading font-bold text-base text-[#1A0B3C]">
                  Key Clinical Takeaways
                </h3>
              </div>

              <ul class="space-y-2.5 pt-1 font-sans text-xs sm:text-sm text-gray-800">
                {keyTakeaways.map((point: string) => (
                  <li class="flex items-start gap-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#853676] mt-2 shrink-0"></span>
                    <span class="leading-relaxed">{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* Card 2: Specialist Care Leader Bio */}
          <div class="rounded-[28px] bg-[#FFFDFC] border-2 border-[#FDDCEB] p-5 sm:p-6 shadow-[0_4px_20px_rgba(228,0,110,0.03)] space-y-4" data-animate="fade-up">
            <div class="flex items-center gap-3">
              <img
                src={doctorImage}
                alt={defaultAuthorName}
                class="w-14 h-14 rounded-full object-cover object-top border-2 border-[#FADCEB] ring-2 ring-[#E4006E]/20 shrink-0"
              />
              <div>
                <span class="text-[10px] font-label font-bold text-[#E4006E] uppercase tracking-wider block">
                  LEAD SPECIALIST
                </span>
                <h4 class="font-heading font-bold text-base text-[#1A0B3C]">
                  {defaultAuthorName}
                </h4>
                <p class="text-xs text-secondary font-sans truncate max-w-[180px]">
                  {defaultAuthorRole}
                </p>
              </div>
            </div>

            <div class="space-y-2 text-xs text-gray-700 font-sans border-t border-[#FADCEB] pt-3">
              <div class="flex items-center gap-2">
                <Award className="w-3.5 h-3.5 text-[#E4006E] shrink-0" />
                <span>Fellow in Fetal Medicine, FMF (UK)</span>
              </div>
              <div class="flex items-center gap-2">
                <Stethoscope className="w-3.5 h-3.5 text-[#853676] shrink-0" />
                <span>Fellowship in Reproductive Medicine</span>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-2 pt-1">
              <a
                href="/contact"
                class="flex items-center justify-center gap-1.5 py-2.5 px-4 rounded-full bg-[#E4006E] hover:bg-[#6B21A8] text-white font-semibold text-xs transition-all shadow-xs"
              >
                <span>Schedule Consultation</span>
                <ArrowRight className="w-3 h-3" />
              </a>
              <a
                href={`tel:${primaryPhone.replace(/\s+/g, '')}`}
                class="flex items-center justify-center gap-1.5 py-2.5 px-4 rounded-full border border-[#FADCEB] bg-white hover:bg-rose-50 text-[#1A0B3C] font-semibold text-xs transition-all"
              >
                <Phone className="w-3 h-3 text-[#E4006E]" />
                <span>Call: {primaryPhone}</span>
              </a>
            </div>
          </div>

          {/* Card 3: Quick Questions & Direct Clinic Inquiries */}
          <div class="rounded-[28px] bg-[#FFF0F6] border border-[#FADCEB] p-5 text-center space-y-2.5" data-animate="fade-up">
            <div class="w-9 h-9 rounded-full bg-white text-[#E4006E] flex items-center justify-center mx-auto border border-rose-100 shadow-2xs">
              <HelpCircle className="w-4 h-4" />
            </div>
            <h4 class="font-heading font-bold text-sm text-[#1A0B3C]">
              Have questions about this article?
            </h4>
            <p class="text-xs text-secondary font-sans leading-relaxed">
              Our clinical care coordinators in Ananthapuram are ready to help clarify your options.
            </p>
            <a
              href={`tel:${primaryPhone.replace(/\s+/g, '')}`}
              class="inline-block font-sans font-bold text-xs text-[#E4006E] hover:underline"
            >
              Call {primaryPhone} →
            </a>
          </div>

        </aside>

      </div>

      {/* =========================================================================
          RELATED PUBLICATIONS SECTION (3 CARDS MATCHING HOME PAGE)
         ========================================================================= */}
      {finalRelatedPosts.length > 0 && (
        <section class="space-y-6 pt-6" data-animate="fade-up">
          <div class="flex items-center justify-between gap-4 flex-wrap">
            <div>
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FFF0F6] border border-[#FADCEB] text-[#E4006E] font-label font-bold text-xs uppercase tracking-wider mb-2">
                <span>EXPLORE MORE</span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-heading font-bold text-[#1A0B3C] tracking-tight">
                Related Clinical Articles & Insights
              </h3>
            </div>

            <a
              href="/blog"
              class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[#E4006E] hover:text-[#6B21A8] transition-colors"
            >
              <span>View All Articles</span>
              <ArrowRight className="w-3.5 h-3.5" />
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 items-stretch">
            {finalRelatedPosts.map((relatedPost) => (
              <div class="flex flex-col h-full w-full" data-animate="fade-up">
                <BlogCard client:load post={relatedPost} />
              </div>
            ))}
          </div>
        </section>
      )}

      {/* =========================================================================
          CLOSING CONSULTATION BANNER
         ========================================================================= */}
      <section class="w-full pb-8 sm:pb-12" data-animate="fade-up">
        <div class="relative overflow-hidden rounded-[32px] sm:rounded-[36px] bg-[#ECA4C6] p-6 sm:p-10 lg:p-12 text-white text-center shadow-[0_12px_40px_rgba(236,164,198,0.35)] border border-pink-200/50">
          
          {/* Subtle Ambient Decorative Circles */}
          <div class="absolute -top-24 -left-24 w-72 h-72 rounded-full bg-white/25 blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-24 -right-24 w-80 h-80 rounded-full bg-white/20 blur-3xl pointer-events-none"></div>

          <div class="relative z-10 max-w-3xl mx-auto space-y-4">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/60 backdrop-blur-md border border-white/80 text-[#5A2149] text-xs font-label font-bold uppercase tracking-wider">
              <span class="w-2 h-2 rounded-full bg-[#5A2149] animate-ping"></span>
              <span>START YOUR CONVERSATION TODAY</span>
            </div>

            <h2 class="text-2xl sm:text-4xl font-heading font-bold text-[#5A2149] tracking-tight leading-tight">
              Ready to Discuss Your Treatment Options?
            </h2>

            <p class="text-[#5A2149]/85 text-xs sm:text-sm md:text-base leading-relaxed font-sans max-w-2xl mx-auto font-medium">
              Schedule a private, empathetic consultation with {defaultAuthorName} at {siteName}.
            </p>

            <div class="pt-3 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
              <a
                href="/contact"
                class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3.5 rounded-full bg-white hover:bg-[#5A2149] text-[#5A2149] hover:text-white font-sans font-bold text-xs sm:text-sm shadow-lg hover:shadow-xl transition-all duration-200 active:scale-[0.98] border border-white/80"
              >
                <span>Schedule Consultation</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                  <line x1="7" y1="17" x2="17" y2="7"/>
                  <polyline points="7 7 17 7 17 17"/>
                </svg>
              </a>

              <a
                href={`tel:${primaryPhone.replace(/[^0-9+]/g, '')}`}
                class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3.5 rounded-full bg-white/60 hover:bg-white/80 backdrop-blur-md border border-white/80 text-[#5A2149] font-sans font-bold text-xs sm:text-sm transition-all duration-200 shadow-sm"
              >
                <Phone className="w-4 h-4 text-[#5A2149]" />
                <span>Call Us: {primaryPhone}</span>
              </a>
            </div>

          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>
