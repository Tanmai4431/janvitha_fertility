---
import Layout from '../../layouts/Layout.astro';
import { getSiteSettings } from '../../utils/sanity';
import client from '../../../../../client.json';
import Breadcrumbs from '../../components/ui/navigation/Breadcrumbs.astro';

export const prerender = true;

export async function getStaticPaths() {
  return (client.services || []).map((service: any) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface SubserviceItem {
  slug?: string;
  title: string;
  desc?: string;
  shortDesc?: string;
  fullDescription?: string;
  procedureSteps?: string[];
  benefits?: string[];
  timeline?: string;
  suitableFor?: string;
}

interface ServiceBenefit {
  title: string;
  desc: string;
  icon?: string;
}

interface ServiceFAQ {
  question: string;
  answer: string;
}

interface ServiceProps {
  id: string;
  slug: string;
  category: string;
  title: string;
  shortDesc: string;
  fullDescription?: string;
  imageUrl?: string;
  videoUrl?: string;
  subservices?: SubserviceItem[];
  features?: string[];
  metrics?: { label: string; value: string }[];
  benefits?: ServiceBenefit[];
  deliverables?: string[];
  faqs?: ServiceFAQ[];
}

interface Props {
  service: ServiceProps;
}

const { service } = Astro.props;

const siteSettings = await getSiteSettings();
const siteName = siteSettings?.name || client.business.name;
const primaryPhone = siteSettings?.primaryPhone || client.contact.primaryPhone;
const primaryEmail = client.contact.primaryEmail || 'info@janvithasfertility.com';
const whatsappPhone = client.contact.whatsappPhone || primaryPhone;
const locationAddress = client.contact.location || 'Opp. Rotary School, Kamala Nagar, Ananthapuram';

const specialist = client.business.specialist;
const doctorName = specialist?.name || 'Dr. P. Bharathi';
const doctorDesignation = specialist?.designation || 'Consultant Obstetrician & Gynaecologist';

// Resolve subservices, benefits, deliverables, and faqs directly from JSON
const subservices: SubserviceItem[] = service.subservices || (service.features || []).map((f: string) => ({
  title: f,
  desc: `Specialized protocol and evidence-based standard care provided at ${siteName}.`
}));

const benefits: ServiceBenefit[] = service.benefits || (service.features || []).map((f: string) => ({
  title: f,
  desc: `Targeted reproductive care protocol conducted by our specialist clinical team.`,
  icon: 'M13 10V3L4 14h7v7l9-11h-7z'
}));

const deliverables: string[] = service.deliverables || [
  'Specialist Clinical Consultation & History Review',
  'Advanced Ultrasound & Laboratory Diagnostics',
  'Personalized Treatment Strategy & Medication Plan',
  'Dedicated Cycle Monitoring & Clinical Support',
];

const faqs: ServiceFAQ[] = service.faqs && service.faqs.length > 0 ? service.faqs : client.faqs || [];

// Other related treatments for cross-navigation
const otherServices = (client.services || [])
  .filter((s: any) => s.slug !== service.slug)
  .slice(0, 3);
---

<Layout
  title={`${service.title} | Specialized Fertility Care | ${siteName}`}
  description={service.shortDesc}
>
  <main class="flex-grow pt-4 sm:pt-6 pb-20 md:pb-28 bg-[#FCFBFA]">
    <div class="flex flex-col space-y-12 sm:space-y-16 lg:space-y-24">

      {/* ── 0. BREADCRUMBS NAVIGATION ── */}
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <Breadcrumbs items={[
          { label: 'Services', href: '/services' },
          { label: service.title }
        ]} className="justify-start mb-1" />
      </div>

      {/* ── 1. HERO BANNER: WHAT IS [SERVICE_NAME]? + IMAGE ── */}
      <section class="w-full">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="relative overflow-hidden rounded-[32px] sm:rounded-[40px] bg-gradient-to-r from-[#FDE8EE] via-[#FFF1F6] to-[#F5EAF7] border border-[#FADCEB] shadow-[0_10px_35px_rgba(228,0,110,0.06)] p-8 sm:p-12 lg:p-16" data-animate="fade-up">
            
            {/* Ambient Background Glow Elements */}
            <div class="absolute -top-20 -left-20 w-80 h-80 rounded-full bg-pink-200/40 blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-20 -right-20 w-96 h-96 rounded-full bg-purple-200/40 blur-3xl pointer-events-none"></div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10">
              
              {/* Left Content: What is {service.title}? */}
              <div class="lg:col-span-7 space-y-5 text-left">
                <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/80 backdrop-blur-md border border-[#FADCEB] text-xs font-label font-bold uppercase tracking-wider text-[#E4006E]">
                  <span class="w-2 h-2 rounded-full bg-[#E4006E] animate-pulse"></span>
                  <span>{service.category || 'Specialized Reproductive Care'}</span>
                </div>

                <h1 class="text-3xl sm:text-5xl lg:text-5.5xl font-heading font-bold text-[#1A0B3C] tracking-tight leading-[1.18]">
                  What is <span class="italic font-normal text-[#E4006E]">{service.title}</span>?
                </h1>

                <p class="text-secondary text-sm sm:text-base lg:text-lg font-sans max-w-xl leading-relaxed">
                  {service.fullDescription || service.shortDesc}
                </p>

                {/* Metrics & Key Highlights */}
                {service.metrics && service.metrics.length > 0 && (
                  <div class="flex flex-wrap gap-2.5 pt-1">
                    {service.metrics.map((m) => (
                      <div class="px-3.5 py-1.5 rounded-xl bg-white border border-[#FADCEB] text-xs font-sans flex items-center gap-1.5 shadow-2xs">
                        <span class="text-secondary font-medium">{m.label}:</span>
                        <span class="font-bold text-[#1A0B3C] font-heading">{m.value}</span>
                      </div>
                    ))}
                  </div>
                )}

                <div class="pt-2 flex flex-wrap items-center gap-4">
                  <a
                    href="/contact"
                    class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full bg-[#853676] hover:bg-[#E4006E] text-white font-sans font-bold text-sm shadow-md transition-all duration-300 active:scale-95"
                  >
                    <span>Book a Consultation</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                      <line x1="7" y1="17" x2="17" y2="7"/>
                      <polyline points="7 7 17 7 17 17"/>
                    </svg>
                  </a>
                  <a
                    href={`tel:${primaryPhone.replace(/[^0-9+]/g, '')}`}
                    class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-white hover:bg-rose-50 border border-[#FADCEB] text-[#1A0B3C] font-sans font-bold text-sm shadow-xs transition-colors"
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#E4006E]">
                      <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 01 4.11 2h3a2 2 0 01 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                    <span>{primaryPhone}</span>
                  </a>
                </div>
              </div>

              {/* Right Side: Service Related Image */}
              <div class="lg:col-span-5 relative flex justify-center lg:justify-end">
                <div class="relative w-full max-w-[440px] aspect-[4/3] sm:aspect-[16/11] rounded-[28px] overflow-hidden shadow-xl border-4 border-white/90 group">
                  <img
                    src={service.imageUrl || '/assets/couple-pregnancy-test.jpg'}
                    alt={service.title}
                    class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                    loading="eager"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-60"></div>
                  <div class="absolute bottom-3 left-3 right-3 p-3 rounded-2xl bg-white/90 backdrop-blur-md border border-white/50 text-left">
                    <p class="text-xs font-bold text-[#1A0B3C] font-heading">{service.title}</p>
                    <p class="text-[11px] text-secondary font-sans truncate">Janvithas Fertility Care • Ananthapuram</p>
                  </div>
                </div>
              </div>

            </div>

          </div>
        </div>
      </section>

      {/* ── 2. SUBSERVICES & PROCEDURES GRID (DEDICATED SEPARATE PAGES) ── */}
      <section class="w-full">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div 
            class="rounded-[36px] sm:rounded-[44px] bg-gradient-to-b from-[#EAE6F9]/70 via-[#FCEDF5]/90 to-[#E3E8FC]/70 border-2 border-[#F3D7E8] p-6 sm:p-10 lg:p-12 shadow-[0_12px_45px_rgba(228,0,110,0.05)] space-y-8 sm:space-y-10"
            data-animate="fade-up"
          >
            
            <div class="text-center max-w-2xl mx-auto space-y-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/90 border border-[#FADCEB] text-xs font-bold text-[#E4006E] uppercase tracking-wider font-label">
                SPECIALIZED PROCEDURES & PROTOCOLS
              </span>
              <h2 class="text-2xl sm:text-4xl font-heading font-bold text-[#1A0B3C]">
                Procedures Included in {service.title}
              </h2>
              <p class="text-secondary text-xs sm:text-sm font-sans">
                Click on any procedure card below to open its dedicated page with complete step-by-step roadmap, clinical benefits, timeline, and candidate criteria.
              </p>
            </div>

            {/* Subservices 2-Column Responsive Grid with Dedicated Page Links */}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
              {(service.subservices || subservices).map((sub, idx) => {
                const isPink = idx % 2 === 0;
                const cardBg = isPink ? 'bg-[#FFF0F6]/95 border-[#FADCEB]' : 'bg-[#FAF0F8]/95 border-[#E8DDF0]';
                const badgeBg = isPink ? 'bg-white text-[#E4006E] border-rose-100' : 'bg-white text-[#853676] border-purple-100';
                const subSlug = sub.slug || `procedure-${idx + 1}`;
                const subUrl = `/services/${service.slug}/${subSlug}`;
                const stepCount = sub.procedureSteps?.length || 4;

                return (
                  <a
                    href={subUrl}
                    class={`rounded-[26px] ${cardBg} border-2 p-6 sm:p-7 flex flex-col justify-between shadow-[0_4px_18px_rgba(26,11,60,0.04)] hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 group text-left relative block`}
                  >
                    <div class="space-y-4">
                      {/* Top Badges Row */}
                      <div class="flex items-center justify-between gap-2">
                        <div class={`w-10 h-10 rounded-xl ${badgeBg} border flex items-center justify-center font-heading font-bold text-sm shadow-xs group-hover:scale-105 transition-transform`}>
                          0{idx + 1}
                        </div>
                        {sub.timeline && (
                          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white/90 border border-black/5 text-[11.5px] font-sans font-medium text-secondary shadow-2xs">
                            <span>⏱️</span>
                            <span class="truncate max-w-[170px]">{sub.timeline}</span>
                          </span>
                        )}
                      </div>

                      {/* Subservice Title */}
                      <h3 class="text-xl sm:text-2xl font-heading font-bold text-[#1A0B3C] group-hover:text-[#E4006E] transition-colors leading-snug">
                        {sub.title}
                      </h3>

                      {/* Short Description */}
                      <p class="text-secondary text-xs sm:text-sm font-sans leading-relaxed line-clamp-3">
                        {sub.shortDesc || sub.desc || sub.fullDescription}
                      </p>

                      {/* Features / Steps Badge */}
                      <div class="pt-1 flex flex-wrap items-center gap-2">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/80 text-[11px] font-sans font-semibold text-[#853676] border border-purple-100">
                          <span>📋</span>
                          <span>{stepCount}-Step Protocol</span>
                        </span>
                        {sub.suitableFor && (
                          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/80 text-[11px] font-sans font-semibold text-[#E4006E] border border-rose-100 truncate max-w-[240px]">
                            <span>🎯</span>
                            <span class="truncate">{sub.suitableFor}</span>
                          </span>
                        )}
                      </div>
                    </div>

                    {/* Bottom Action Row with Dedicated Link CTA */}
                    <div class="mt-6 pt-4 border-t border-black/5 flex items-center justify-between">
                      <span class="text-xs sm:text-sm font-bold text-[#853676] group-hover:text-[#E4006E] font-sans transition-colors flex items-center gap-2">
                        <span>View Procedure Details</span>
                        <span class="group-hover:translate-x-1 transition-transform">→</span>
                      </span>

                      <div
                        class="w-9 h-9 rounded-full bg-[#853676] group-hover:bg-[#E4006E] text-white flex items-center justify-center shadow-xs transition-all duration-200 group-hover:scale-110 shrink-0"
                      >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                          <line x1="7" y1="17" x2="17" y2="7"/>
                          <polyline points="7 7 17 7 17 17"/>
                        </svg>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>

            <div class="text-center pt-2">
              <p class="text-xs sm:text-sm font-sans text-secondary">
                Need guidance on this treatment? {' '}
                <a
                  href="/contact"
                  class="font-bold text-[#E4006E] hover:text-[#1A0B3C] underline underline-offset-4"
                >
                  Book A Personal Consultation with Dr. P. Bharathi
                </a>
              </p>
            </div>

          </div>
        </div>
      </section>

      {/* ── 3. CLINICAL ADVANTAGES & CARE PATHWAY ── */}
      <section class="w-full">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            {/* Left: Why Choose Us (Benefits) */}
            <div class="lg:col-span-7 space-y-6 text-left" data-animate="fade-up">
              <div class="space-y-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FFF0F6] border border-[#FADCEB] text-xs font-bold text-[#E4006E] uppercase tracking-wider font-label">
                  CLINICAL EXCELLENCE
                </span>
                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-bold text-[#1A0B3C]">
                  Why Choose Janvithas for <span class="italic font-normal text-[#E4006E]">{service.title}</span>
                </h2>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                {benefits.map((b) => (
                  <div class="p-5 rounded-[22px] bg-white border border-[#FADCEB] space-y-2 shadow-2xs hover:border-[#E4006E] transition-colors">
                    <div class="w-8 h-8 rounded-xl bg-[#FFF0F6] border border-rose-100 text-[#E4006E] flex items-center justify-center">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                        <path d={b.icon || 'M13 10V3L4 14h7v7l9-11h-7z'}/>
                      </svg>
                    </div>
                    <h3 class="font-heading font-bold text-sm sm:text-base text-[#1A0B3C]">{b.title}</h3>
                    <p class="text-secondary text-xs font-sans leading-relaxed">{b.desc}</p>
                  </div>
                ))}
              </div>
            </div>

            {/* Right: Care Inclusions Checklist */}
            <div class="lg:col-span-5 space-y-4 text-left" data-animate="fade-up">
              <div class="rounded-[28px] bg-gradient-to-br from-[#FFF5F8] to-[#FAF0F8] border border-[#FADCEB] p-6 sm:p-8 space-y-5">
                <div class="space-y-1">
                  <span class="text-xs font-bold uppercase tracking-wider text-[#853676] font-label">CARE PATHWAY</span>
                  <h3 class="text-xl font-heading font-bold text-[#1A0B3C]">Deliverables Included</h3>
                </div>

                <div class="space-y-2.5">
                  {deliverables.map((item) => (
                    <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white border border-[#F2D8E6] shadow-2xs">
                      <div class="w-6 h-6 rounded-full bg-[#FFF0F6] text-[#E4006E] flex items-center justify-center shrink-0 border border-rose-100">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
                          <polyline points="20 6 9 17 4 12"/>
                        </svg>
                      </div>
                      <span class="text-xs sm:text-sm font-bold text-[#1A0B3C] font-sans">{item}</span>
                    </div>
                  ))}
                </div>

                {/* Doctor Note */}
                <div class="pt-2 border-t border-[#FADCEB] flex items-center gap-3">
                  <img
                    src={specialist?.image || '/assets/doctor-dr-p-bharathi.jpg'}
                    alt={doctorName}
                    class="w-11 h-11 rounded-full object-cover border border-rose-300 shrink-0"
                  />
                  <div>
                    <p class="text-xs font-bold text-[#1A0B3C]">{doctorName}</p>
                    <p class="text-[11px] text-secondary font-sans">{doctorDesignation}</p>
                  </div>
                </div>

              </div>
            </div>

          </div>
        </div>
      </section>

      {/* ── 4. FAQS & SIDE CONTACT CARD ── */}
      {faqs.length > 0 && (
        <section class="w-full">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
              
              {/* Left FAQ Area */}
              <div class="lg:col-span-7 space-y-6 text-left" data-animate="fade-up">
                <div class="space-y-2">
                  <div class="inline-flex items-center gap-1.5 text-xs font-bold text-[#E4006E] uppercase tracking-wider font-label">
                    <span>• FAQS</span>
                  </div>
                  <h2 class="text-2xl sm:text-4xl font-heading font-bold text-[#1A0B3C] leading-tight">
                    Questions About <span class="italic font-normal text-[#E4006E]">{service.title}</span>
                  </h2>
                  <p class="text-secondary text-xs sm:text-sm font-sans max-w-lg">
                    Have questions about the procedure, timeline, or preparation? Read below or reach out to our medical coordinators.
                  </p>
                </div>

                <div class="space-y-3 pt-2">
                  {faqs.map((faq, idx) => (
                    <details
                      class="group p-5 rounded-[22px] bg-white border border-[#FADCEB] open:border-[#E4006E] open:shadow-sm transition-all duration-200"
                      open={idx === 0}
                    >
                      <summary class="flex items-center justify-between cursor-pointer list-none font-heading font-bold text-sm sm:text-base text-[#1A0B3C] group-hover:text-[#E4006E] transition-colors">
                        <span class="pr-2">{faq.question}</span>
                        <span class="w-6 h-6 rounded-full bg-[#FFF0F6] text-[#E4006E] flex items-center justify-center text-xs font-bold group-open:rotate-180 transition-transform duration-200 shrink-0">
                          ↓
                        </span>
                      </summary>
                      <div class="pt-3 text-secondary text-xs sm:text-sm leading-relaxed font-sans border-t border-rose-100 mt-3">
                        {faq.answer}
                      </div>
                    </details>
                  ))}
                </div>
              </div>

              {/* Right Contact Card */}
              <div class="lg:col-span-5 lg:sticky lg:top-24" data-animate="fade-up">
                <div class="rounded-[28px] bg-white border-2 border-[#FADCEB] p-6 sm:p-8 space-y-6 shadow-[0_6px_25px_rgba(228,0,110,0.04)] text-left">
                  
                  <div class="text-center space-y-1">
                    <h3 class="text-lg sm:text-xl font-heading font-bold text-[#E4006E]">
                      Curious About {service.title}? Let&apos;s Talk.
                    </h3>
                    <p class="text-xs text-secondary font-sans">
                      Our coordinators will provide transparent timeline and cost estimates.
                    </p>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                    <a
                      href={`tel:${primaryPhone.replace(/[^0-9+]/g, '')}`}
                      class="p-4 rounded-2xl bg-[#FFF0F6] border border-[#FADCEB] hover:border-[#E4006E] space-y-1 text-left transition-colors group"
                    >
                      <div class="flex items-center gap-2 text-xs font-bold text-[#E4006E]">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                        </svg>
                        <span>Call Us!</span>
                      </div>
                      <p class="text-xs font-bold font-sans text-[#1A0B3C] group-hover:text-[#E4006E] truncate">
                        {primaryPhone}
                      </p>
                    </a>

                    <a
                      href={`mailto:${primaryEmail}`}
                      class="p-4 rounded-2xl bg-[#FAF0F8] border border-[#F2D8E6] hover:border-[#853676] space-y-1 text-left transition-colors group"
                    >
                      <div class="flex items-center gap-2 text-xs font-bold text-[#853676]">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                          <polyline points="22,6 12,13 2,6"/>
                        </svg>
                        <span>Email Us!</span>
                      </div>
                      <p class="text-xs font-bold font-sans text-[#1A0B3C] group-hover:text-[#853676] truncate">
                        {primaryEmail}
                      </p>
                    </a>
                  </div>

                  <div class="pt-2">
                    <a
                      href="/contact"
                      class="w-full block py-3.5 px-4 rounded-full bg-[#E4006E] hover:bg-[#1A0B3C] text-white text-center font-sans font-bold text-xs sm:text-sm shadow-md transition-all duration-200 active:scale-95"
                    >
                      Schedule Treatment Consultation
                    </a>
                  </div>

                </div>
              </div>

            </div>
          </div>
        </section>
      )}

      {/* ── 5. OTHER RELATED TREATMENTS ── */}
      <section class="w-full">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-xl sm:text-2xl font-heading font-bold text-[#1A0B3C]">
              Explore Other Treatments
            </h3>
            <a href="/services" class="text-xs sm:text-sm font-bold text-[#E4006E] hover:underline font-sans">
              View All 9 Services →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            {otherServices.map((other: any) => (
              <a
                href={`/services/${other.slug}`}
                class="p-6 rounded-[24px] bg-white border border-[#FADCEB] hover:border-[#E4006E] shadow-xs hover:shadow-lg transition-all duration-300 space-y-2.5 text-left group"
              >
                <span class="text-[10px] font-bold uppercase tracking-wider text-[#E4006E] bg-[#FFF0F6] px-2.5 py-0.5 rounded-full border border-[#FADCEB]">
                  {other.category}
                </span>
                <h4 class="font-heading font-bold text-base text-[#1A0B3C] group-hover:text-[#E4006E] transition-colors">
                  {other.title}
                </h4>
                <p class="text-secondary text-xs font-sans line-clamp-2">
                  {other.shortDesc}
                </p>
                <div class="pt-2 text-xs font-bold text-[#853676] group-hover:text-[#E4006E] flex items-center gap-1">
                  <span>Explore Procedure</span>
                  <span>→</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      {/* ── 6. BOTTOM CONSULTATION CTA BANNER ── */}
      <section class="w-full">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="rounded-[32px] sm:rounded-[40px] bg-gradient-to-r from-[#9C1D72] via-[#C41E7F] to-[#E4006E] p-8 sm:p-12 lg:p-14 text-white shadow-[0_12px_40px_rgba(196,30,127,0.22)]" data-animate="fade-up">
            
            <div class="flex flex-col lg:flex-row items-center justify-between gap-6 text-left">
              <div class="space-y-2 max-w-2xl">
                <h2 class="text-2xl sm:text-4xl lg:text-5xl font-heading font-bold text-white leading-tight">
                  Schedule your {service.title} consultation <span class="italic font-normal text-pink-200">Today!</span>
                </h2>
                <p class="text-white/90 text-xs sm:text-base font-sans leading-relaxed">
                  Start your conversation with Dr. P. Bharathi and take the first step towards your parenthood journey.
                </p>
              </div>

              <div class="shrink-0">
                <a
                  href="/contact"
                  class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-white text-[#E4006E] hover:bg-[#1A0B3C] hover:text-white font-sans font-bold text-sm sm:text-base shadow-lg transition-all duration-200 active:scale-95"
                >
                  <span>Book an appointment</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                    <line x1="7" y1="17" x2="17" y2="7"/>
                    <polyline points="7 7 17 7 17 17"/>
                  </svg>
                </a>
              </div>
            </div>

          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>

