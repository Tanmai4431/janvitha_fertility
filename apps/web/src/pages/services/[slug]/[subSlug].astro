---
import Layout from '../../../layouts/Layout.astro';
import { getSiteSettings } from '../../../utils/sanity';
import client from '../../../../../../client.json';
import Breadcrumbs from '../../../components/ui/navigation/Breadcrumbs.astro';

export const prerender = true;

export async function getStaticPaths() {
  const paths: any[] = [];
  (client.services || []).forEach((service: any) => {
    const subservices = service.subservices || [];
    subservices.forEach((subservice: any, idx: number) => {
      const subSlug = subservice.slug || `procedure-${idx + 1}`;
      paths.push({
        params: {
          slug: service.slug,
          subSlug: subSlug,
        },
        props: {
          service,
          subservice,
          siblingSubservices: subservices.filter((s: any) => (s.slug || `procedure-${idx + 1}`) !== subSlug),
        },
      });
    });
  });
  return paths;
}

interface SubserviceItem {
  slug?: string;
  title: string;
  desc?: string;
  shortDesc?: string;
  fullDescription?: string;
  procedureSteps?: string[];
  benefits?: string[];
  timeline?: string;
  suitableFor?: string;
}

interface ServiceProps {
  id: string;
  slug: string;
  category: string;
  title: string;
  shortDesc: string;
  fullDescription?: string;
  imageUrl?: string;
  subservices?: SubserviceItem[];
}

interface Props {
  service: ServiceProps;
  subservice: SubserviceItem;
  siblingSubservices: SubserviceItem[];
}

const { service, subservice, siblingSubservices = [] } = Astro.props;

const siteSettings = await getSiteSettings();
const siteName = siteSettings?.name || client.business.name;
const primaryPhone = siteSettings?.primaryPhone || client.contact.primaryPhone;
const primaryEmail = client.contact.primaryEmail || 'info@janvithasfertility.com';
const whatsappPhone = client.contact.whatsappPhone || primaryPhone;
const locationAddress = client.contact.location || 'Opp. Rotary School, Kamala Nagar, Ananthapuram';

const specialist = client.business.specialist;
const doctorName = specialist?.name || 'Dr. P. Bharathi';
const doctorDesignation = specialist?.designation || 'Consultant Obstetrician & Gynaecologist';

// Fallback steps if empty
const steps = subservice.procedureSteps && subservice.procedureSteps.length > 0
  ? subservice.procedureSteps
  : [
      'Initial Clinical Assessment and Reproductive History Evaluation',
      'High-Precision Diagnostic Imaging and Biomarker Profiling',
      'Targeted Protocol Execution and Real-Time Monitoring',
      'Post-Procedure Review and Next Phase Care Planning',
    ];

// Fallback benefits if empty
const benefitsList = subservice.benefits && subservice.benefits.length > 0
  ? subservice.benefits
  : [
      'Evidence-based protocol optimized for individual patient parameters',
      'Minimizes clinical risks while maximizing successful fertilization outcomes',
      'Direct oversight by Dr. P. Bharathi throughout the treatment cycle',
    ];
---

<Layout
  title={`${subservice.title} | ${service.title} | ${siteName}`}
  description={subservice.shortDesc || subservice.fullDescription || `${subservice.title} clinical procedure at ${siteName}.`}
>
  <main class="flex-grow pt-4 sm:pt-6 pb-20 md:pb-28 bg-background">
    <div class="flex flex-col space-y-12 sm:space-y-16 lg:space-y-24">

      {/* ── 0. BREADCRUMBS NAVIGATION ── */}
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <Breadcrumbs items={[
          { label: 'Services', href: '/services' },
          { label: service.title, href: `/services/${service.slug}` },
          { label: subservice.title }
        ]} className="justify-start mb-1" />
      </div>

      {/* ── 1. HERO SECTION: WHAT IS [SUBSERVICE]? + CLINICAL VISUAL ── */}
      <section class="w-full">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div 
            class="relative overflow-hidden rounded-[32px] sm:rounded-[40px] bg-gradient-to-r from-[#FDE8EE] via-[#FFF1F6] to-[#F5EAF7] border border-[#FADCEB] shadow-[0_10px_35px_rgba(228,0,110,0.06)] p-8 sm:p-12 lg:p-16" 
            data-animate="fade-up"
          >
            {/* Ambient Background Glow */}
            <div class="absolute -top-20 -left-20 w-80 h-80 rounded-full bg-pink-200/40 blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-20 -right-20 w-96 h-96 rounded-full bg-purple-200/40 blur-3xl pointer-events-none"></div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10">
              
              {/* Left Column: What is {subservice.title}? */}
              <div class="lg:col-span-7 space-y-5 text-left">
                <div class="flex flex-wrap items-center gap-2">
                  <a
                    href={`/services/${service.slug}`}
                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/80 backdrop-blur-md border border-[#FADCEB] text-xs font-label font-bold uppercase tracking-wider text-[#853676] hover:text-[#E4006E] transition-colors"
                  >
                    <span>←</span>
                    <span>{service.title}</span>
                  </a>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#E4006E]/10 border border-[#FADCEB] text-xs font-label font-bold uppercase tracking-wider text-[#E4006E]">
                    Specialized Procedure
                  </span>
                </div>

                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-bold text-[#1A0B3C] tracking-tight leading-[1.18]">
                  What is <span class="italic font-normal text-[#E4006E]">{subservice.title}</span>?
                </h1>

                <p class="text-secondary text-sm sm:text-base lg:text-lg font-sans max-w-xl leading-relaxed">
                  {subservice.fullDescription || subservice.shortDesc || subservice.desc}
                </p>

                {/* Key Quick Highlight Chips */}
                <div class="flex flex-wrap gap-2.5 pt-1">
                  {subservice.timeline && (
                    <div class="px-3.5 py-1.5 rounded-xl bg-white border border-[#FADCEB] text-xs font-sans flex items-center gap-2 shadow-2xs">
                      <span class="text-base">⏱️</span>
                      <div>
                        <span class="text-secondary font-medium block text-[10px] uppercase tracking-wider">Estimated Timeline</span>
                        <span class="font-bold text-[#1A0B3C] font-heading text-xs">{subservice.timeline}</span>
                      </div>
                    </div>
                  )}

                  {subservice.suitableFor && (
                    <div class="px-3.5 py-1.5 rounded-xl bg-white border border-[#FADCEB] text-xs font-sans flex items-center gap-2 shadow-2xs max-w-md">
                      <span class="text-base">🎯</span>
                      <div>
                        <span class="text-secondary font-medium block text-[10px] uppercase tracking-wider">Suitable For</span>
                        <span class="font-bold text-[#1A0B3C] font-heading text-xs truncate block max-w-[280px]">{subservice.suitableFor}</span>
                      </div>
                    </div>
                  )}
                </div>

                {/* CTAs */}
                <div class="pt-2 flex flex-wrap items-center gap-4">
                  <a
                    href="/contact"
                    class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full bg-[#853676] hover:bg-[#E4006E] text-white font-sans font-bold text-sm shadow-md transition-all duration-300 active:scale-95"
                  >
                    <span>Book Procedure Consultation</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                      <line x1="7" y1="17" x2="17" y2="7"/>
                      <polyline points="7 7 17 7 17 17"/>
                    </svg>
                  </a>
                  <a
                    href={`tel:${primaryPhone.replace(/[^0-9+]/g, '')}`}
                    class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-white hover:bg-rose-50 border border-[#FADCEB] text-[#1A0B3C] font-sans font-bold text-sm shadow-xs transition-colors"
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#E4006E]">
                      <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 01 4.11 2h3a2 2 0 01 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                    <span>{primaryPhone}</span>
                  </a>
                </div>
              </div>

              {/* Right Column: Procedure Visual Card */}
              <div class="lg:col-span-5 relative flex justify-center lg:justify-end">
                <div class="relative w-full max-w-[440px] aspect-[4/3] sm:aspect-[16/11] rounded-[28px] overflow-hidden shadow-xl border-4 border-white/90 group">
                  <img
                    src={service.imageUrl || '/assets/couple-pregnancy-test.jpg'}
                    alt={subservice.title}
                    class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                    loading="eager"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent opacity-70"></div>
                  
                  {/* Floating Doctor Badge */}
                  <div class="absolute bottom-3 left-3 right-3 p-3 rounded-2xl bg-white/95 backdrop-blur-md border border-white/60 text-left flex items-center gap-3 shadow-md">
                    <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-[#E4006E] shrink-0">
                      <img src="/assets/doctor-dr-p-bharathi.jpg" alt={doctorName} class="w-full h-full object-cover" />
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs font-bold text-[#1A0B3C] font-heading truncate">Clinical Oversight: {doctorName}</p>
                      <p class="text-[11px] text-secondary font-sans truncate">{doctorDesignation}</p>
                    </div>
                  </div>
                </div>
              </div>

            </div>

          </div>
        </div>
      </section>

      {/* ── 2. STEP-BY-STEP PROCEDURE ROADMAP ── */}
      <section class="w-full">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div 
            class="rounded-[36px] sm:rounded-[44px] bg-gradient-to-b from-[#EAE6F9]/70 via-[#FCEDF5]/90 to-[#E3E8FC]/70 border-2 border-[#F3D7E8] p-6 sm:p-10 lg:p-12 shadow-[0_12px_45px_rgba(228,0,110,0.05)] space-y-8 sm:space-y-10"
            data-animate="fade-up"
          >
            
            <div class="text-center max-w-2xl mx-auto space-y-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/90 border border-[#FADCEB] text-xs font-bold text-[#E4006E] uppercase tracking-wider font-label">
                TREATMENT PROTOCOL & ROADMAP
              </span>
              <h2 class="text-2xl sm:text-4xl font-heading font-bold text-[#1A0B3C]">
                Step-by-Step Clinical Pathway
              </h2>
              <p class="text-secondary text-xs sm:text-sm font-sans">
                A structured, evidence-based sequence designed to ensure safety, clarity, and the highest clinical success.
              </p>
            </div>

            {/* Sequential Steps Grid */}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
              {steps.map((stepText, idx) => {
                const isPink = idx % 2 === 0;
                const cardBg = isPink ? 'bg-[#FFF0F6]/95 border-[#FADCEB]' : 'bg-[#FAF0F8]/95 border-[#E8DDF0]';
                const badgeColor = isPink ? 'bg-[#E4006E] text-white' : 'bg-[#853676] text-white';

                return (
                  <div class={`p-6 sm:p-7 rounded-[26px] ${cardBg} border-2 shadow-xs space-y-3 text-left relative overflow-hidden group hover:shadow-md transition-all duration-300`}>
                    <div class="flex items-center justify-between">
                      <span class={`inline-flex items-center justify-center px-3 py-1 rounded-full ${badgeColor} font-heading font-bold text-xs shadow-xs tracking-wider uppercase`}>
                        Step 0{idx + 1}
                      </span>
                      <span class="text-xs text-secondary font-sans font-medium">Phase {idx + 1}</span>
                    </div>

                    <p class="text-sm sm:text-base font-sans font-semibold text-[#1A0B3C] leading-relaxed pt-1">
                      {stepText}
                    </p>
                  </div>
                );
              })}
            </div>

            {/* Reassurance Note */}
            <div class="p-4 sm:p-5 rounded-2xl bg-white/80 border border-[#FADCEB] text-center max-w-3xl mx-auto">
              <p class="text-xs sm:text-sm font-sans text-secondary">
                💡 <span class="font-bold text-[#1A0B3C]">Personalized Care Note:</span> Each protocol step is monitored personally by <span class="text-[#E4006E] font-bold">{doctorName}</span> with real-time ultrasound and lab assessments to calibrate medication dosages to your individual biological profile.
              </p>
            </div>

          </div>
        </div>
      </section>

      {/* ── 3. CLINICAL BENEFITS & ADVANTAGES ── */}
      <section class="w-full">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            {/* Left Column: Benefits Cards */}
            <div class="lg:col-span-7 space-y-6 text-left" data-animate="fade-up">
              <div class="space-y-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FFF0F6] border border-[#FADCEB] text-xs font-bold text-[#E4006E] uppercase tracking-wider font-label">
                  PROVEN CLINICAL ADVANTAGES
                </span>
                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-bold text-[#1A0B3C]">
                  Why this procedure matters for <span class="italic font-normal text-[#E4006E]">Your Conception Journey</span>
                </h2>
              </div>

              <div class="grid grid-cols-1 gap-4 pt-1">
                {benefitsList.map((benefit, bIdx) => (
                  <div class="p-5 sm:p-6 rounded-[22px] bg-white border-2 border-[#FADCEB] shadow-2xs hover:border-[#E4006E] transition-all flex items-start gap-4">
                    <div class="w-9 h-9 rounded-xl bg-[#FFF0F6] border border-rose-100 text-[#E4006E] flex items-center justify-center shrink-0 mt-0.5">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                    </div>
                    <div class="space-y-1">
                      <h3 class="font-heading font-bold text-base text-[#1A0B3C]">
                        {typeof benefit === 'string' ? benefit : benefit}
                      </h3>
                      <p class="text-xs sm:text-sm font-sans text-secondary leading-relaxed">
                        Conducted following international reproductive guidelines with cutting-edge equipment in Ananthapuram.
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* Right Column: Candidate Suitability Card */}
            <div class="lg:col-span-5 space-y-6 text-left" data-animate="fade-up">
              <div class="p-7 sm:p-8 rounded-[32px] bg-gradient-to-br from-[#FFF0F6] to-[#FAF0F8] border-2 border-[#F3D7E8] shadow-sm space-y-5">
                <div class="space-y-2">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-[#FADCEB] text-xs font-bold text-[#853676] uppercase tracking-wider font-label">
                    PATIENT SUITABILITY
                  </span>
                  <h3 class="text-xl sm:text-2xl font-heading font-bold text-[#1A0B3C]">
                    Is {subservice.title} Right for You?
                  </h3>
                </div>

                <p class="text-secondary text-xs sm:text-sm font-sans leading-relaxed">
                  {subservice.suitableFor || `Couples seeking precision fertility diagnosis or individuals exploring assisted conception under ${service.title}.`}
                </p>

                <div class="pt-2 space-y-3">
                  <div class="flex items-center gap-3 text-xs sm:text-sm font-sans text-[#1A0B3C]">
                    <span class="w-5 h-5 rounded-full bg-rose-100 text-[#E4006E] flex items-center justify-center text-xs font-bold shrink-0">✓</span>
                    <span>Complimentary preliminary history review</span>
                  </div>
                  <div class="flex items-center gap-3 text-xs sm:text-sm font-sans text-[#1A0B3C]">
                    <span class="w-5 h-5 rounded-full bg-rose-100 text-[#E4006E] flex items-center justify-center text-xs font-bold shrink-0">✓</span>
                    <span>Customized medication and timing chart</span>
                  </div>
                  <div class="flex items-center gap-3 text-xs sm:text-sm font-sans text-[#1A0B3C]">
                    <span class="w-5 h-5 rounded-full bg-rose-100 text-[#E4006E] flex items-center justify-center text-xs font-bold shrink-0">✓</span>
                    <span>Direct WhatsApp clinical coordination</span>
                  </div>
                </div>

                <div class="pt-3 border-t border-[#F8E7F0]">
                  <a
                    href="/contact"
                    class="w-full inline-flex items-center justify-center gap-2 py-3.5 rounded-full bg-[#853676] hover:bg-[#E4006E] text-white font-sans font-bold text-xs sm:text-sm shadow-md transition-all duration-300"
                  >
                    <span>Request Evaluation for this Procedure</span>
                    <span>→</span>
                  </a>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      {/* ── 4. SIBLING PROCEDURES IN THIS SERVICE (CROSS-NAVIGATION) ── */}
      {siblingSubservices && siblingSubservices.length > 0 && (
        <section class="w-full">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="space-y-6 text-left" data-animate="fade-up">
              <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-[#FADCEB] pb-4">
                <div>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FFF0F6] border border-[#FADCEB] text-xs font-bold text-[#E4006E] uppercase tracking-wider font-label">
                    EXPLORE RELATED PROCEDURES
                  </span>
                  <h2 class="text-2xl sm:text-3xl font-heading font-bold text-[#1A0B3C] pt-1">
                    Other Procedures in <span class="italic font-normal text-[#E4006E]">{service.title}</span>
                  </h2>
                </div>

                <a
                  href={`/services/${service.slug}`}
                  class="text-xs sm:text-sm font-bold text-[#853676] hover:text-[#E4006E] font-sans transition-colors flex items-center gap-1.5 shrink-0"
                >
                  <span>View All {service.title} Overview</span>
                  <span>→</span>
                </a>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
                {siblingSubservices.map((sib, sIdx) => {
                  const isPink = sIdx % 2 === 0;
                  const cardBg = isPink ? 'bg-[#FFF0F6]/90 border-[#FADCEB]' : 'bg-[#FAF0F8]/90 border-[#E8DDF0]';
                  const sibSlug = sib.slug || `procedure-${sIdx + 1}`;

                  return (
                    <a
                      href={`/services/${service.slug}/${sibSlug}`}
                      class={`p-5 sm:p-6 rounded-[24px] ${cardBg} border-2 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group text-left block`}
                    >
                      <div class="space-y-2">
                        <div class="flex items-center justify-between text-xs text-secondary font-sans">
                          <span class="font-bold text-[#853676]">{service.title}</span>
                          {sib.timeline && <span>⏱️ {sib.timeline}</span>}
                        </div>
                        <h3 class="font-heading font-bold text-lg text-[#1A0B3C] group-hover:text-[#E4006E] transition-colors leading-snug">
                          {sib.title}
                        </h3>
                        <p class="text-xs text-secondary font-sans leading-relaxed line-clamp-2">
                          {sib.shortDesc || sib.desc || sib.fullDescription}
                        </p>
                      </div>

                      <div class="mt-4 pt-3 border-t border-black/5 flex items-center justify-between text-xs font-bold text-[#853676] group-hover:text-[#E4006E] font-sans">
                        <span>View Procedure</span>
                        <span class="group-hover:translate-x-1 transition-transform">→</span>
                      </div>
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
        </section>
      )}

      {/* ── 5. BOTTOM CLINICAL CONSULTATION CTA CARD ── */}
      <section class="w-full">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="relative overflow-hidden rounded-[32px] sm:rounded-[40px] bg-[#ECA4C6] p-8 sm:p-12 lg:p-16 text-white text-center sm:text-left shadow-[0_12px_40px_rgba(236,164,198,0.35)] border border-pink-200/50" data-animate="fade-up">
            
            {/* Ambient Highlights */}
            <div class="absolute -top-24 -left-24 w-72 h-72 rounded-full bg-white/25 blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-24 -right-24 w-80 h-80 rounded-full bg-white/20 blur-3xl pointer-events-none"></div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
              <div class="lg:col-span-8 space-y-4">
                <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-white/60 border border-white/80 text-xs font-bold uppercase tracking-wider font-label text-[#5A2149] backdrop-blur-md">
                  CONSULTATION & GUIDANCE
                </span>
                <h2 class="text-2xl sm:text-4xl font-heading font-bold text-[#5A2149] leading-tight">
                  Have Questions About {subservice.title}?
                </h2>
                <p class="text-[#5A2149]/85 text-xs sm:text-sm lg:text-base font-sans max-w-xl leading-relaxed font-medium">
                  Schedule a private, in-depth clinical consultation with Dr. P. Bharathi to review your medical history and determine if {subservice.title} is the optimal choice for your fertility roadmap.
                </p>
              </div>

              <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-center lg:justify-end">
                <a
                  href="/contact"
                  class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-white hover:bg-[#5A2149] text-[#5A2149] hover:text-white font-sans font-bold text-sm shadow-lg hover:shadow-xl transition-all duration-300 active:scale-[0.98] border border-white/80"
                >
                  <span>Book Appointment Now</span>
                  <span>→</span>
                </a>
                <a
                  href={`tel:${primaryPhone.replace(/[^0-9+]/g, '')}`}
                  class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-white/60 hover:bg-white/80 backdrop-blur-md border border-white/80 text-[#5A2149] font-sans font-bold text-sm transition-colors shadow-sm"
                >
                  <span>Call {primaryPhone}</span>
                </a>
              </div>
            </div>

          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>
