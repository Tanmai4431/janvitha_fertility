            ))}
          </div>

          {/* Explore More Articles CTA Button Below the 3 Cards */}
          <div class="pt-2 sm:pt-4 flex justify-center w-full" data-animate="zoom-in">
            <InteractiveHoverButton client:visible href="/blog">
              Explore More Articles
            </InteractiveHoverButton>
          </div>

        </div>
      </section>

      {/* ── 11. ACCREDITATIONS & TRUST BADGES (PINK BACKGROUND) ── */}
