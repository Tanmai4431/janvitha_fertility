              <p class="text-secondary text-sm sm:text-base font-sans leading-relaxed">
                {doctorBio}
              </p>

              {/* Qualifications Pill List */}
              <div class="space-y-2.5 pt-1">
                <p class="text-xs font-bold uppercase tracking-wider text-[#1A0B3C] font-label">
                  Recognitions & Fellowships:
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  {doctorQualifications.map((qual: string) => (
                    <div class="flex items-center gap-2.5 p-3 rounded-[16px] bg-white border border-[#FADCEB] text-xs font-bold text-[#1A0B3C] shadow-2xs">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#E4006E] shrink-0">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      <span>{qual}</span>
                    </div>
                  ))}
                </div>
              </div>

              <div class="pt-2">
                <a
                  href="/contact"
                  class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-[#E4006E] hover:bg-[#2A125E] text-white font-sans font-bold text-sm shadow-[0_4px_16px_rgba(228,0,110,0.3)] transition-all duration-200"
                >
                  <span>Consult with {doctorName}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                    <line x1="7" y1="17" x2="17" y2="7"/>
                    <polyline points="7 7 17 7 17 17"/>
                  </svg>
                </a>
              </div>

            </div>

          </div>

        </div>
      </section>

      {/* ── 8. SPECIALIZED FERTILITY TREATMENTS GRID (WHITE BACKGROUND) ── */}
      <section class="w-full py-14 sm:py-20 lg:py-24 bg-white scroll-mt-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          
