                </div>
              </details>
            ))}
          </div>

        </div>
      </section>

      {/* ── 13. BOTTOM HIGH-IMPACT CONSULTATION CTA (PINK BACKGROUND) ── */}
      <section class="w-full py-14 sm:py-20 lg:py-24 bg-[#FFF0F6] border-t border-[#FADCEB]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="rounded-[32px] sm:rounded-[40px] bg-gradient-to-r from-[#9C1D72] via-[#C41E7F] to-[#E4006E] p-8 sm:p-12 lg:p-16 text-white text-center shadow-[0_12px_40px_rgba(196,30,127,0.25)] space-y-6" data-animate="fade-up">
            
            <div class="max-w-2xl mx-auto space-y-3">
              <h2 class="text-2xl sm:text-4xl lg:text-5xl font-heading font-bold text-white">
                Ready to Begin Your Journey?
              </h2>
              <p class="text-white/90 text-sm sm:text-base font-sans leading-relaxed">
                Schedule a confidential consultation with Dr. P. Bharathi today at Janvithas Fertility Center, Ananthapuram.
              </p>
            </div>

            <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
              <a
                href="/contact"
                class="px-8 py-4 rounded-full bg-white text-[#E4006E] hover:bg-[#1A0B3C] hover:text-white font-sans font-bold text-sm sm:text-base shadow-lg transition-all duration-200 active:scale-95"
              >
                Book Appointment Online
              </a>
              <a
                href={`https://wa.me/${whatsappPhone.replace(/[^0-9]/g, '')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="px-8 py-4 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-sans font-bold text-sm sm:text-base shadow-lg transition-all duration-200 flex items-center gap-2"
