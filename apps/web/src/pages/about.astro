---
import Layout from '../layouts/Layout.astro';
import { sanityClient, getSiteSettings, getHomePage, urlFor } from '../utils/sanity';
import client from '../../../../client.json';
import Breadcrumbs from '../components/ui/navigation/Breadcrumbs.astro';
import TestimonialsSection from '../components/sections/home/TestimonialsSection';
import { BlogCard, type BlogCardPost } from '../components/ui/BlogCard';
import InteractiveHoverButton from '../components/ui/buttons/interactive-hover-button';
import BlogHeadingRoll from '../components/ui/typography/BlogHeadingRoll';

// Fetch Sanity settings and dynamic data with fallback to client.json
const siteSettings = await getSiteSettings();
const homePage = await getHomePage();

const siteName = siteSettings?.name || client.business.name;
const siteDescription = siteSettings?.description || client.business.description;

const specialist = client.business.specialist;
const doctorName = specialist?.name || 'Dr. P. Bharathi';
const doctorDesignation = specialist?.designation || 'Consultant Obstetrician & Gynaecologist';
const doctorBio = specialist?.bio || client.business.description;
const doctorQualifications = specialist?.qualifications || [
  'Fellow in Fetal Medicine, FMF (UK)',
  'Recognised Fellowship in Reproductive Medicine',
];

const primaryPhone = client.contact.primaryPhone || '+91 81214 49988';
const whatsappPhone = client.contact.whatsappPhone || '+91 81214 49988';
const locationAddress = client.contact.location || 'Opp. Rotary School, Kamala Nagar, Ananthapuram';

// Key Services for Treatment Highlights Grid
const highlightedServices = client.services.slice(0, 6);

// FAQs
const faqs = client.faqs || [];

// Fetch blog posts from Sanity CMS (Identical to Home Page)
let rawPosts: any[] = [];
try {
  rawPosts = await sanityClient.fetch(`
    *[_type == "post"] | order(publishedAt desc) {
      title,
      "slug": slug.current,
      category,
      readTime,
      isFeatured,
      videoUrl,
      "videoFileUrl": videoFile.asset->url,
      author,
      authorRole,
      "authorAvatarUrl": authorAvatar.asset->url,
      tags,
      excerpt,
      publishedAt,
      mainImage
    }
  `);
} catch (e) {
  console.error("Failed to fetch posts from Sanity:", e);
}

// Map Sanity raw posts to BlogCardPost structure
const mappedPosts: BlogCardPost[] = (rawPosts || []).map((p) => {
  let mainImageUrl = '';
  if (p.mainImage) {
    try {
      mainImageUrl = urlFor(p.mainImage).width(800).height(450).format('webp').url();
    } catch (e) {
      console.error('Failed to format mainImage URL:', e);
    }
  }
  return {
    title: p.title || 'Untitled Publication',
    slug: p.slug || '',
    category: p.category || 'Insights & Trends',
    readTime: p.readTime || '4 min read',
    publishedAt: p.publishedAt || new Date().toISOString(),
    excerpt: p.excerpt || 'Discover clinical guidance and reproductive health insights.',
    mainImageUrl,
    videoUrl: p.videoFileUrl || p.videoUrl || undefined,
    authorName: p.author || client.business.specialist?.name || client.business.name,
    authorRole: p.authorRole || client.business.specialist?.designation || 'Medical Specialist',
    authorAvatarUrl: p.authorAvatarUrl || undefined,
    tags: p.tags || ['IVF Care', 'Fertility', 'Reproductive Medicine'],
    isFeatured: p.isFeatured || false,
  };
});

// Fallback clinical guidance posts for Janvithas Fertility Center (Identical to Home Page)
const sampleFallbackPosts: BlogCardPost[] = [
  {
    title: 'Understanding When to Visit a Fertility Specialist: Key Signs & Guidelines',
    slug: 'understanding-when-to-visit-a-fertility-specialist',
    category: 'Fertility Evaluation',
    readTime: '4 min read',
    publishedAt: new Date(Date.now() - 86400000 * 2).toISOString(),
    excerpt: 'Comprehensive guidance on when couples and individuals should consider early fertility diagnostics, ovarian reserve testing, and semen analysis.',
    mainImageUrl: 'https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=1200&q=80',
    authorName: client.business.specialist?.name || 'Dr. P. Bharathi',
    authorRole: client.business.specialist?.designation || 'Consultant Obstetrician & Gynaecologist',
    tags: ['Fertility Assessment', 'Women Health', 'Reproductive Care'],
    isFeatured: true,
  },
  {
    title: 'Advanced Assisted Reproduction: Comparing IUI, IVF, and ICSI Protocols',
    slug: 'comparing-iui-ivf-and-icsi-protocols',
    category: 'Assisted Reproduction',
    readTime: '6 min read',
    publishedAt: new Date(Date.now() - 86400000 * 5).toISOString(),
    excerpt: 'A clear clinical comparison of modern assisted reproductive options, from gentle IUI insemination to micromanipulated ICSI and PICSI techniques.',
    mainImageUrl: 'https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=1200&q=80',
    authorName: client.business.specialist?.name || 'Dr. P. Bharathi',
    authorRole: client.business.specialist?.designation || 'Consultant Obstetrician & Gynaecologist',
    tags: ['IVF Care', 'ICSI', 'IUI Treatment'],
    isFeatured: false,
  },
  {
    title: 'The Role of Blastocyst Culture & Day-5 Embryo Incubation in IVF Success',
    slug: 'role-of-blastocyst-culture-day-5-embryo-incubation',
    category: 'Embryology',
    readTime: '5 min read',
    publishedAt: new Date(Date.now() - 86400000 * 9).toISOString(),
    excerpt: 'How extended Day-5 embryology culture and physiological selection significantly enhance single-embryo transfer implantation success rates.',
    mainImageUrl: 'https://images.unsplash.com/photo-1516549655169-df83a0774514?auto=format&fit=crop&w=1200&q=80',
    authorName: client.business.specialist?.name || 'Dr. P. Bharathi',
    authorRole: client.business.specialist?.designation || 'Consultant Obstetrician & Gynaecologist',
    tags: ['Blastocyst', 'Embryology', 'IVF Success'],
    isFeatured: true,
  },
];

// Combine posts ensuring exactly 3 posts are displayed (Identical to Home Page)
const finalPosts: BlogCardPost[] = [
  ...mappedPosts,
  ...sampleFallbackPosts.filter(sp => !mappedPosts.some(mp => mp.slug === sp.slug))
].slice(0, 3);
---

<Layout
  title={`About Us | ${siteName} - Leading Fertility & IVF Clinic in Ananthapuram`}
  description={siteDescription}
>
  <main class="flex-grow bg-background">
    <div class="flex flex-col">
      
      {/* ── 0. BREADCRUMBS ROW & HERO ── */}
      <section class="w-full pt-4 sm:pt-6 pb-6 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full space-y-4">
          <Breadcrumbs items={[{ label: 'About Us' }]} className="justify-start mb-1" />

          {/* 1. HERO BANNER HEADER */}
          <div class="relative overflow-hidden rounded-[32px] sm:rounded-[40px] bg-gradient-to-r from-[#9C1D72] via-[#C41E7F] to-[#E4006E] p-8 sm:p-12 lg:p-16 text-white text-center shadow-[0_12px_40px_rgba(196,30,127,0.25)]" data-animate="fade-up">
            {/* Background Decorative Rings */}
            <div class="absolute -top-24 -left-24 w-72 h-72 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
            <div class="absolute -bottom-24 -right-24 w-80 h-80 rounded-full bg-[#1A0B3C]/20 blur-3xl pointer-events-none"></div>
            
            <div class="relative z-10 max-w-3xl mx-auto space-y-4">
              <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/15 backdrop-blur-md border border-white/25 text-white text-xs sm:text-sm font-label font-bold uppercase tracking-wider">
                <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
                <span>Welcome to Janvithas</span>
              </div>
              <h1 class="text-3xl sm:text-5xl lg:text-6xl font-heading font-bold tracking-tight text-white leading-tight">
                About Our Hospital
              </h1>
              <p class="text-white/90 text-sm sm:text-base lg:text-lg font-sans max-w-2xl mx-auto leading-relaxed">
                Dedicated to making world-class reproductive medicine and compassionate fertility care accessible to every aspiring family in Ananthapuram.
              </p>
            </div>
          </div>

          {/* 2. KEY STATS METRICS ROW */}
          <div class="pt-4 sm:pt-6">
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
              
              {/* Metric 1 */}
              <div class="p-5 sm:p-6 rounded-[24px] bg-[#FFF0F6] border border-[#FADCEB] shadow-[0_4px_20px_rgba(228,0,110,0.04)] flex items-center gap-4 hover:border-[#E4006E] hover:shadow-md transition-all duration-300" data-animate="fade-up">
                <div class="w-12 h-12 rounded-2xl bg-white text-[#E4006E] flex items-center justify-center shrink-0 border border-rose-100 shadow-xs">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                </div>
                <div>
                  <p class="text-2xl sm:text-3xl font-heading font-bold text-[#1A0B3C]">15+ Yrs</p>
                  <p class="text-xs sm:text-sm text-secondary font-sans font-medium">Clinical Experience</p>
                </div>
              </div>

              {/* Metric 2 */}
              <div class="p-5 sm:p-6 rounded-[24px] bg-[#FAF0F8] border border-[#EEDBF2] shadow-[0_4px_20px_rgba(133,54,118,0.04)] flex items-center gap-4 hover:border-[#853676] hover:shadow-md transition-all duration-300" data-animate="fade-up">
                <div class="w-12 h-12 rounded-2xl bg-white text-[#853676] flex items-center justify-center shrink-0 border border-purple-100 shadow-xs">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-2xl sm:text-3xl font-heading font-bold text-[#1A0B3C]">10,000+</p>
                  <p class="text-xs sm:text-sm text-secondary font-sans font-medium">Happy Families</p>
                </div>
              </div>

              {/* Metric 3 */}
              <div class="p-5 sm:p-6 rounded-[24px] bg-[#FFF0F6] border border-[#FADCEB] shadow-[0_4px_20px_rgba(228,0,110,0.04)] flex items-center gap-4 hover:border-[#E4006E] hover:shadow-md transition-all duration-300" data-animate="fade-up">
                <div class="w-12 h-12 rounded-2xl bg-white text-[#E4006E] flex items-center justify-center shrink-0 border border-rose-100 shadow-xs">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
                    <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                  </svg>
                </div>
                <div>
                  <p class="text-2xl sm:text-3xl font-heading font-bold text-[#1A0B3C]">85%+</p>
                  <p class="text-xs sm:text-sm text-secondary font-sans font-medium">IVF Success Rate</p>
                </div>
              </div>

              {/* Metric 4 */}
              <div class="p-5 sm:p-6 rounded-[24px] bg-[#FAF0F8] border border-[#EEDBF2] shadow-[0_4px_20px_rgba(133,54,118,0.04)] flex items-center gap-4 hover:border-[#853676] hover:shadow-md transition-all duration-300" data-animate="fade-up">
                <div class="w-12 h-12 rounded-2xl bg-white text-[#853676] flex items-center justify-center shrink-0 border border-purple-100 shadow-xs">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-2xl sm:text-3xl font-heading font-bold text-[#1A0B3C]">10+ ART</p>
                  <p class="text-xs sm:text-sm text-secondary font-sans font-medium">Advanced Treatments</p>
                </div>
              </div>

            </div>
          </div>

        </div>
      </section>

      {/* ── 3. CLINIC INTRO / STORY SECTION: OUR PROMISE & PURPOSE (PINK BACKGROUND) ── */}
      <section class="w-full py-14 sm:py-20 lg:py-24 bg-[#FFF0F6] border-y border-[#FADCEB] scroll-mt-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
            
            {/* LEFT: LAYERED FAMILY IMAGERY */}
            <div class="lg:col-span-5 relative flex items-center justify-center" data-animate="fade-up">
              <div class="relative w-full max-w-[460px]">
                <div class="overflow-hidden rounded-[32px] border-4 border-white shadow-[0_10px_35px_rgba(228,0,110,0.12)]">
                  <img
                    src="/assets/about-client-hero.jpg"
                    alt="Janvithas Fertility Center - Helping Families"
                    class="w-full h-auto object-cover block"
                    loading="lazy"
                  />
                </div>
                {/* Floating Experience Badge */}
                <div class="absolute -bottom-5 -right-3 sm:-bottom-6 sm:-right-4 bg-gradient-to-r from-[#E4006E] to-[#9C1D72] text-white p-4 sm:p-5 rounded-[22px] shadow-lg border-2 border-white flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center shrink-0">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-base sm:text-lg font-bold font-heading leading-tight">15+ Years</p>
                    <p class="text-[11px] sm:text-xs text-white/90 font-sans">Trusted IVF Center</p>
                  </div>
                </div>
              </div>
            </div>

            {/* RIGHT: STORY & CLINICAL PROMISE */}
            <div class="lg:col-span-7 space-y-5 sm:space-y-6 text-left" data-animate="fade-up">
              <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white border border-[#FADCEB]">
                <span class="w-2 h-2 rounded-full bg-[#E4006E] inline-block animate-pulse"></span>
                <span class="font-label font-bold uppercase tracking-wider text-[#E4006E] text-xs sm:text-[13px]">
                  OUR PROMISE & PURPOSE
                </span>
              </div>

              <h2 class="text-3xl sm:text-4xl lg:text-[40px] font-heading font-bold tracking-tight text-[#1A0B3C] leading-[1.2]">
                Bringing Dreams to Life with <br class="hidden sm:inline" />
                <span class="text-[#E4006E]">Care, Precision & Compassion</span>
              </h2>

              <p class="text-secondary text-sm sm:text-base leading-relaxed font-sans">
                {client.business.description}
              </p>

              <div class="p-5 rounded-[22px] bg-white border border-[#FADCEB] flex items-center gap-4 shadow-xs">
                <div class="w-11 h-11 rounded-full bg-[#FFF0F6] text-[#E4006E] border border-rose-200 flex items-center justify-center shrink-0 shadow-xs">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                  </svg>
                </div>
                <div class="text-left font-sans">
                  <p class="font-bold text-[#1A0B3C] text-sm sm:text-base">
                    {client.business.tagline}
                  </p>
                  <p class="text-secondary text-xs sm:text-[13px]">
                    {client.business.accessibilityStatement}
                  </p>
                </div>
              </div>

              <div class="pt-2 flex flex-wrap gap-4">
                <a
                  href="/contact"
                  class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-[#E4006E] hover:bg-[#2A125E] text-white font-sans font-bold text-sm shadow-[0_4px_16px_rgba(228,0,110,0.3)] transition-all duration-200 active:scale-[0.98] group"
                >
                  <span>Book Consultation</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white group-hover:translate-x-0.5 transition-transform">
                    <line x1="7" y1="17" x2="17" y2="7"/>
                    <polyline points="7 7 17 7 17 17"/>
                  </svg>
                </a>
                <a
                  href={`tel:${primaryPhone.replace(/[^0-9+]/g, '')}`}
                  class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white hover:bg-rose-50 border-2 border-[#FADCEB] text-[#1A0B3C] font-sans font-bold text-sm transition-all duration-200"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#E4006E]">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  <span>Call Us: {primaryPhone}</span>
                </a>
              </div>

            </div>

          </div>
        </div>
      </section>

      {/* ── 4. VISION & MISSION DUAL SHOWCASE (WHITE BACKGROUND) ── */}
      <section class="w-full py-14 sm:py-20 lg:py-24 bg-white scroll-mt-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
            
            {/* LEFT: SECONDARY FAMILY / BABY PHOTO */}
            <div class="lg:col-span-5 relative" data-animate="fade-up">
              <div class="overflow-hidden rounded-[32px] border-2 border-[#FADCEB] shadow-[0_8px_30px_rgba(228,0,110,0.08)]">
                <img
                  src="https://images.unsplash.com/photo-1516549655169-df83a0774514?auto=format&fit=crop&w=1000&q=80"
                  alt="Happy Mother and Baby at Janvithas Fertility"
                  class="w-full h-[380px] sm:h-[420px] object-cover block"
                  loading="lazy"
                />
              </div>
            </div>

            {/* RIGHT: VIBRANT PILL VISION & MISSION CARDS */}
            <div class="lg:col-span-7 space-y-5" data-animate="fade-up">
              
              {/* Vision Card */}
              <div class="p-6 sm:p-8 rounded-[28px] bg-gradient-to-r from-[#E4006E] to-[#C41E7F] text-white shadow-md space-y-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-white/20 border border-white/30 flex items-center justify-center shrink-0">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white">
                      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                      <circle cx="12" cy="12" r="3"/>
                    </svg>
                  </div>
                  <h3 class="text-xl sm:text-2xl font-heading font-bold text-white">
                    Our Vision
                  </h3>
                </div>
                <p class="text-white/95 text-sm sm:text-base leading-relaxed font-sans pl-1">
                  {client.business.vision}
                </p>
              </div>

              {/* Mission Card */}
              <div class="p-6 sm:p-8 rounded-[28px] bg-gradient-to-r from-[#853676] to-[#5C1A50] text-white shadow-md space-y-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-white/20 border border-white/30 flex items-center justify-center shrink-0">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white">
                      <circle cx="12" cy="12" r="10"/>
                      <circle cx="12" cy="12" r="6"/>
                      <circle cx="12" cy="12" r="2"/>
                    </svg>
                  </div>
                  <h3 class="text-xl sm:text-2xl font-heading font-bold text-white">
                    Our Mission
                  </h3>
                </div>
                <p class="text-white/95 text-sm sm:text-base leading-relaxed font-sans pl-1">
                  {client.business.mission}
                </p>
              </div>

            </div>

          </div>
        </div>
      </section>

      {/* ── 5. CORE VALUES & PRINCIPLES (PINK BACKGROUND) ── */}
      <section class="w-full py-14 sm:py-20 lg:py-24 bg-[#FFF0F6] border-y border-[#FADCEB] scroll-mt-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          
          <div class="text-center max-w-3xl mx-auto space-y-3 mb-8 sm:mb-12" data-animate="fade-up">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white border border-[#FADCEB]">
              <span class="font-label font-bold uppercase tracking-wider text-[#E4006E] text-xs sm:text-[13px]">
                GUIDING PILLARS
              </span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-heading font-bold text-[#1A0B3C]">
              Guided by Integrity & Clinical Excellence
            </h2>
            <p class="text-secondary text-sm sm:text-base font-sans">
              Our core values shape every diagnosis, protocol, and interaction at Janvithas Fertility Center.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {client.business.coreValues.map((val, idx) => (
              <div 
                class={`p-6 sm:p-7 rounded-[26px] border-2 transition-all duration-300 space-y-3 shadow-xs hover:-translate-y-1 hover:shadow-md bg-white ${
                  idx % 2 === 0 
                    ? 'border-[#E4006E]/30 hover:border-[#E4006E]' 
                    : 'border-[#853676]/30 hover:border-[#853676]'
                }`}
                data-animate="fade-up"
              >
                <div class={`w-10 h-10 rounded-full flex items-center justify-center shadow-xs ${
                  idx % 2 === 0 ? 'bg-[#FFF0F6] text-[#E4006E]' : 'bg-[#FAF0F8] text-[#853676]'
                }`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                    {idx === 0 && <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>}
                    {idx === 1 && <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>}
                    {idx === 2 && <circle cx="12" cy="12" r="10"/>}
                    {idx === 3 && <polyline points="20 6 9 17 4 12"/>}
                  </svg>
                </div>
                <h3 class="text-lg font-heading font-bold text-[#1A0B3C]">
                  {val.title}
                </h3>
                <p class="text-secondary text-xs sm:text-sm leading-relaxed font-sans">
                  {val.description}
                </p>
              </div>
            ))}
          </div>

        </div>
      </section>

      {/* ── 6. 4-STEP JOURNEY TO PARENTHOOD (WHITE BACKGROUND) ── */}
      <section class="w-full py-14 sm:py-20 lg:py-24 bg-white scroll-mt-24">
