                <span class="font-label font-bold uppercase tracking-wider text-[#E4006E] text-xs sm:text-[13px]">
                  CLINICAL LEADERSHIP
                </span>
              </div>

              <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-bold text-[#1A0B3C]">
                Meet {doctorName}
