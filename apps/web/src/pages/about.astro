      {/* ── 10. PUBLICATIONS & BLOGS FEED SECTION (WHITE BACKGROUND) ── */}
      <section id="publications" class="w-full py-14 sm:py-20 lg:py-24 bg-white scroll-mt-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-10">
          
          {/* Centered Section Header Badge & Dynamic Shifting Title */}
