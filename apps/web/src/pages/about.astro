                <p class="font-heading font-bold text-base text-[#1A0B3C] group-hover:text-[#853676] transition-colors">FMF (UK) Certified</p>
                <p class="text-xs text-secondary font-sans">Fetal Medicine Standards</p>
              </div>
              <div class="p-5 sm:p-6 rounded-[22px] bg-white border-2 border-[#FADCEB] hover:border-[#853676] hover:bg-[#FAF0F8] space-y-1.5 shadow-xs hover:shadow-md transition-all duration-200 cursor-pointer group">
                <p class="font-heading font-bold text-base text-[#1A0B3C] group-hover:text-[#853676] transition-colors">ICMR Compliant</p>
                <p class="text-xs text-secondary font-sans">Ethical ART Protocols</p>
              </div>
              <div class="p-5 sm:p-6 rounded-[22px] bg-white border-2 border-[#FADCEB] hover:border-[#853676] hover:bg-[#FAF0F8] space-y-1.5 shadow-xs hover:shadow-md transition-all duration-200 cursor-pointer group">
                <p class="font-heading font-bold text-base text-[#1A0B3C] group-hover:text-[#853676] transition-colors">Cleanroom ART Lab</p>
                <p class="text-xs text-secondary font-sans">HEPA Filtered Air</p>
              </div>
              <div class="p-5 sm:p-6 rounded-[22px] bg-white border-2 border-[#FADCEB] hover:border-[#853676] hover:bg-[#FAF0F8] space-y-1.5 shadow-xs hover:shadow-md transition-all duration-200 cursor-pointer group">
                <p class="font-heading font-bold text-base text-[#1A0B3C] group-hover:text-[#853676] transition-colors">100% Confidential</p>
                <p class="text-xs text-secondary font-sans">Patient Privacy Guarantee</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* ── 12. FREQUENTLY ASKED QUESTIONS (WHITE BACKGROUND) ── */}
      <section class="w-full py-14 sm:py-20 lg:py-24 bg-white scroll-mt-24">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          
          <div class="text-center space-y-2 mb-8 sm:mb-12" data-animate="fade-up">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#FFF0F6] border border-[#FADCEB]">
              <span class="font-label font-bold uppercase tracking-wider text-[#E4006E] text-xs sm:text-[13px]">
                COMMON INQUIRIES
              </span>
            </div>
            <h2 class="text-2xl sm:text-4xl font-heading font-bold text-[#1A0B3C]">
              Frequently Asked Questions
            </h2>
            <p class="text-secondary text-xs sm:text-sm font-sans">
              Clear answers to help you make informed decisions about your fertility journey.
            </p>
          </div>

          <div class="space-y-4">
            {faqs.map((faq, idx) => (
              <details class="group p-5 sm:p-6 rounded-[22px] bg-white border border-[#FADCEB] open:border-[#E4006E] shadow-2xs transition-all duration-200" data-animate="fade-up">
                <summary class="flex items-center justify-between cursor-pointer list-none font-heading font-bold text-base sm:text-lg text-[#1A0B3C] group-hover:text-[#E4006E] transition-colors">
