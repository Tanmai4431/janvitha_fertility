        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center space-y-6" data-animate="fade-up">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white border border-[#FADCEB]">
