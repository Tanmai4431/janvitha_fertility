---
import Layout from '../layouts/Layout.astro';
import { getSiteSettings } from '../utils/sanity';
import client from '../../../../client.json';
import Breadcrumbs from '../components/ui/navigation/Breadcrumbs.astro';
import { OurWorksSection } from '../components/sections/home/OurWorksSection';
import TestimonialsSection from '../components/sections/home/TestimonialsSection';

const siteSettings = await getSiteSettings();
const siteName = siteSettings?.name || client.business.name;

const works = (client.works || []) as any[];

const specialist = client.business.specialist;
const doctorName = specialist?.name || "Dr. P. Bharathi";
const designation = specialist?.designation || "Consultant Obstetrician & Gynaecologist";
const primaryPhone = client.contact.primaryPhone || "+91 81214 49988";

// Key Doctor Achievements & Clinical Milestones
const clinicalAchievements = [
  {
    title: "15+ Years Clinical Excellence",
    description: "Extensive experience in advanced reproductive medicine, ovulation induction, and complex infertility management.",
    icon: "award"
  },
  {
    title: "Fetal Medicine Fellowship (FMF UK)",
    description: "Internationally recognized certification in high-risk pregnancy diagnostics, fetal ultrasounds, and early genetic screening.",
    icon: "fmf"
  },
  {
    title: "Recognised Fellowship in Reproductive Medicine",
    description: "Specialized training in state-of-the-art ART protocols, individualized stimulation, and blastocyst transfers.",
    icon: "microscope"
  },
  {
    title: "85%+ IVF Implantation Success Rate",
    description: "Consistently high clinical pregnancy rates achieved through Day-5 blastocyst culture and advanced PICSI sperm selection.",
    icon: "trend"
  }
];
---

<Layout
  title={`Success Stories, Patient Journeys & Doctor Achievements | ${siteName}`}
  description={`Explore real patient success stories, advanced clinical care showcases, doctor achievements by ${doctorName}, and verified testimonials at ${siteName}.`}
>
  <main class="flex-grow py-4 sm:py-6 md:py-8 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 sm:space-y-8">
      
      {/* Top Breadcrumbs Navigation */}
      <Breadcrumbs items={[{ label: 'Success Stories' }]} className="justify-start mb-0" />

      {/* =========================================================================
          HERO BANNER: Success Stories, Patient Journeys & Clinical Achievements
         ========================================================================= */}
      <section class="w-full" data-animate="fade-up">
        <div class="rounded-[32px] sm:rounded-[36px] bg-[#FFFDFC] border-2 border-[#FDDCEB] p-6 sm:p-8 lg:p-10 shadow-[0_4px_30px_rgba(228,0,110,0.04)] text-center space-y-4">
          
          <div class="inline-flex items-center justify-center gap-2 px-3.5 py-1.5 rounded-full bg-[#FFF0F6] border border-[#FADCEB]">
            <span class="text-[#E4006E] animate-spin text-sm shrink-0">✱</span>
            <span class="font-label font-bold uppercase tracking-wider text-[#E4006E] text-xs sm:text-[13px]">
              PATIENT STORIES & CLINICAL ACHIEVEMENTS
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-bold tracking-tight text-[#1A0B3C] leading-tight max-w-4xl mx-auto">
            Real Stories of Hope, <span class="text-[#E4006E]">Compassionate Care</span> & Verified Success
          </h1>

          <p class="text-secondary text-sm sm:text-base md:text-lg leading-relaxed max-w-3xl mx-auto font-sans">
            Every parenthood journey is unique. Discover how personalized reproductive protocols, precision embryology, and the clinical expertise of <span class="text-[#1A0B3C] font-semibold">{doctorName}</span> turn cherished dreams of parenthood into reality.
          </p>

          {/* Quick Metrics Pills Row */}
          <div class="pt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 max-w-4xl mx-auto">
            <div class="p-3.5 rounded-[20px] bg-[#FFF0F6] border border-[#FADCEB] text-center">
              <span class="block text-xl sm:text-2xl font-heading font-bold text-[#E4006E]">85%+</span>
              <span class="text-xs text-secondary font-sans font-medium">IVF Success Rate</span>
            </div>
            <div class="p-3.5 rounded-[20px] bg-[#FAF0F8] border border-[#EEDBF2] text-center">
              <span class="block text-xl sm:text-2xl font-heading font-bold text-[#853676]">10,000+</span>
              <span class="text-xs text-secondary font-sans font-medium">Happy Families</span>
            </div>
            <div class="p-3.5 rounded-[20px] bg-[#FFF0F6] border border-[#FADCEB] text-center">
              <span class="block text-xl sm:text-2xl font-heading font-bold text-[#E4006E]">15+ Yrs</span>
              <span class="text-xs text-secondary font-sans font-medium">Clinical Experience</span>
            </div>
            <div class="p-3.5 rounded-[20px] bg-[#FAF0F8] border border-[#EEDBF2] text-center">
              <span class="block text-xl sm:text-2xl font-heading font-bold text-[#853676]">FMF (UK)</span>
              <span class="text-xs text-secondary font-sans font-medium">Fetal Medicine</span>
            </div>
          </div>

        </div>
      </section>

      {/* =========================================================================
          SECTION 1: PATIENT STORIES & CLINICAL CARE SHOWCASE CAROUSEL
         ========================================================================= */}
      <OurWorksSection client:visible works={works} />

      {/* =========================================================================
          SECTION 2: DOCTOR ACHIEVEMENTS & CLINICAL EXCELLENCE SHOWCASE
         ========================================================================= */}
      <section class="w-full space-y-4" data-animate="fade-up">
        <div class="text-center max-w-2xl mx-auto pt-2">
          <div class="inline-flex items-center justify-center gap-2 px-3.5 py-1 rounded-full bg-[#FFF0F6] border border-[#FADCEB] mb-2">
            <span class="font-label font-bold uppercase tracking-wider text-[#E4006E] text-xs">
              CLINICAL EXCELLENCE & CREDENTIALS
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-bold text-[#1A0B3C]">
            Achievements & <span class="text-[#E4006E]">Clinical Excellence</span>
          </h2>
          <p class="text-secondary text-xs sm:text-sm font-sans mt-1">
            Led by {doctorName} • {designation}
          </p>
        </div>

        {/* Clinical Achievements Cards Grid */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 pt-2">
          {clinicalAchievements.map((item, idx) => (
            <div 
              class={`p-5 rounded-[24px] bg-[#FFFDFC] border-2 transition-all duration-300 shadow-xs hover:-translate-y-1 hover:shadow-md ${
                idx % 2 === 0 ? 'border-[#FDDCEB] hover:border-[#E4006E]' : 'border-[#EEDBF2] hover:border-[#853676]'
              }`}
            >
              <div class="flex items-center gap-3 mb-2.5">
                <div class={`w-9 h-9 rounded-[12px] flex items-center justify-center shrink-0 border ${
                  idx % 2 === 0 
                    ? 'bg-[#FFF0F6] text-[#E4006E] border-rose-100' 
                    : 'bg-[#FAF0F8] text-[#853676] border-purple-100'
                }`}>
                  {item.icon === 'award' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                      <circle cx="12" cy="8" r="7"/>
                      <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
                    </svg>
                  )}
                  {item.icon === 'fmf' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                  )}
                  {item.icon === 'microscope' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                      <path d="M6 18h8"/>
                      <path d="M3 22h18"/>
                      <path d="M14 22a7 7 0 1 0 0-14h-1"/>
                      <path d="M9 14h2"/>
                      <path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/>
                      <path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/>
                    </svg>
                  )}
                  {item.icon === 'trend' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                      <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
                      <polyline points="16 7 22 7 22 13"/>
                    </svg>
                  )}
                </div>
                <h3 class="text-xs sm:text-sm font-heading font-bold text-[#1A0B3C] leading-snug">
                  {item.title}
                </h3>
              </div>
              <p class="text-[11.5px] sm:text-xs text-secondary leading-relaxed font-sans">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </section>

      {/* =========================================================================
          SECTION 3: TESTIMONIALS SECTION (REVIEWS FROM REAL PATIENTS)
         ========================================================================= */}
      <TestimonialsSection client:visible />

      {/* =========================================================================
          SECTION 4: START YOUR SUCCESS STORY CTA BANNER
         ========================================================================= */}
      <section class="w-full pb-8 sm:pb-12" data-animate="fade-up">
        <div class="rounded-[32px] sm:rounded-[36px] bg-gradient-to-r from-[#9C1D72] via-[#C41E7F] to-[#E4006E] p-6 sm:p-10 lg:p-12 text-white text-center shadow-[0_12px_40px_rgba(196,30,127,0.25)] relative overflow-hidden">
          
          {/* Subtle Ambient Decorative Circles */}
          <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
          <div class="absolute -bottom-20 -right-20 w-64 h-64 rounded-full bg-black/15 blur-2xl pointer-events-none"></div>

          <div class="relative z-10 max-w-3xl mx-auto space-y-4">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-white text-xs font-label font-bold uppercase tracking-wider">
              <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
              <span>YOUR JOURNEY STARTS HERE</span>
            </div>

            <h2 class="text-2xl sm:text-4xl lg:text-5xl font-heading font-bold text-white tracking-tight leading-tight">
              Ready to Begin Your Own <br class="hidden sm:inline" />
              Success Story?
            </h2>

            <p class="text-white/90 text-xs sm:text-sm md:text-base leading-relaxed font-sans max-w-2xl mx-auto">
              Schedule a confidential, one-on-one consultation with {doctorName} at {siteName} and take the first step towards welcoming your little one.
            </p>

            <div class="pt-3 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
              <a
                href="/contact"
                class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3.5 rounded-full bg-white hover:bg-rose-50 text-[#9C1D72] font-sans font-bold text-xs sm:text-sm shadow-lg hover:shadow-xl transition-all duration-200 active:scale-[0.98]"
              >
                <span>Book Your Consultation</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                  <line x1="7" y1="17" x2="17" y2="7"/>
                  <polyline points="7 7 17 7 17 17"/>
                </svg>
              </a>

              <a
                href={`tel:${primaryPhone.replace(/[^0-9+]/g, '')}`}
                class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3.5 rounded-full bg-white/15 hover:bg-white/25 backdrop-blur-md border border-white/30 text-white font-sans font-bold text-xs sm:text-sm transition-all duration-200"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>Call Us: {primaryPhone}</span>
              </a>
            </div>

          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>
