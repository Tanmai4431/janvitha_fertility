---
import Layout from '../layouts/Layout.astro';
import SectionMapper from '../components/SectionMapper.astro';
import { sanityClient } from '../utils/sanity';
import Breadcrumbs from '../components/ui/navigation/Breadcrumbs.astro';

const { slug } = Astro.params;
const pageSlug = slug === undefined ? '/' : slug;

// Fetch page data from Sanity matching the slug (supporting '/' and empty strings for home)
let page: any = null;
try {
  page = await sanityClient.fetch(
    `*[_type == "page" && (slug.current == $slug || slug.current == $slugAlternative)][0] {
      title,
      slug,
      seo {
        title,
        description,
        shareImage,
        noindex
      },
      pageBuilder
    }`,
    { 
      slug: pageSlug,
      slugAlternative: pageSlug === '/' ? '' : pageSlug 
    }
  );
} catch (e) {
  console.error('[Sanity Fetch Exception] Failed to query dynamic page:', e);
}

// If no matching dynamic CMS page exists:
if (!page) {
  // If requesting root '/', index.astro handles it natively; redirect to 404 only for non-root subpaths
  if (slug !== undefined && slug !== '' && pageSlug !== '/') {
    return Astro.redirect('/404');
  }
}

// Resolve SEO metadata overrides from Sanity settings page
const pageTitle = page?.seo?.title || page?.title || 'Page';
const pageDescription = page?.seo?.description || undefined;
const pageShareImage = page?.seo?.shareImage || undefined;
const noindex = page?.seo?.noindex || false;
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  shareImage={pageShareImage}
  noindex={noindex}
>
  <main class="flex-grow pt-10 sm:pt-12 pb-24 bg-background">
    {pageSlug !== '/' && (
      <div class="max-w-7xl mx-auto px-6 pt-1 sm:pt-1.5 pb-2">
        <Breadcrumbs items={[{ label: pageTitle }]} className="justify-start mb-3 sm:mb-4" />
      </div>
    )}

    {page?.pageBuilder && page.pageBuilder.length > 0 ? (
      page.pageBuilder.map((block: any) => (
        <SectionMapper block={block} />
      ))
    ) : (
      <section class="py-24 px-6 text-center max-w-lg mx-auto space-y-6">
        <div class="inline-flex p-3 bg-amber-50 rounded-card border border-amber-100 text-amber-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"/>
            <path d="M3 9h18"/>
            <path d="M9 21V9"/>
          </svg>
        </div>
        <div class="space-y-2">
          <h2 class="text-2xl font-heading font-bold text-primary">Empty Page</h2>
          <p class="text-sm text-secondary font-sans">
            This page has been successfully generated in the database, but contains no active layout sections. Connect to Sanity Studio and add some blocks!
          </p>
        </div>
      </section>
    )}
  </main>
</Layout>
